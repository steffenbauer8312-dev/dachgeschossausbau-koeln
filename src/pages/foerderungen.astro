---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const foerderungen = [
  {
    title: 'KfW 261 – Wohngebäude Kredit (Effizienzhaus)',
    category: 'Bundesförderung',
    icon: 'building',
    description: 'Zinsgünstiger Kredit mit Tilgungszuschuss für die Komplettsanierung zum Effizienzhaus. Für den DG-Ausbau besonders interessant: Erweiterung von Nichtwohnfläche in Wohnfläche wird gefördert.',
    details: [
      { label: 'Kreditbetrag', value: 'Bis zu 120.000 € pro Wohneinheit (bis 150.000 € mit EE-Klasse)' },
      { label: 'Tilgungszuschuss', value: '5-20 % je nach Effizienzhaus-Standard' },
      { label: 'Zinssatz', value: 'Ab ca. 2,23 % effektiver Jahreszins' },
      { label: 'Voraussetzung', value: 'Mindestens EH 85, Energieeffizienz-Experte erforderlich' },
    ],
    highlights: [
      'DG-Ausbau als Erweiterung förderfähig (Sanierung)',
      'Tilgungszuschuss muss nicht zurückgezahlt werden',
      'Kombinierbar mit BAFA- und NRW.BANK-Förderung',
    ],
    links: [
      { text: 'KfW 261: kfw.de/261', url: 'https://www.kfw.de/inlandsfoerderung/Privatpersonen/Bestehende-Immobilie/F%C3%B6rderprodukte/Bundesf%C3%B6rderung-f%C3%BCr-effiziente-Geb%C3%A4ude-Wohngeb%C3%A4ude-Kredit-(261-262)/' },
    ],
    note: 'KfW 262 (Einzelmaßnahmen-Kredit) ist aktuell EINGESTELLT und kann nicht mehr beantragt werden. Für Einzelmaßnahmen nutzen Sie BAFA BEG EM (Zuschuss).'
  },
  {
    title: 'BAFA BEG EM – Einzelmaßnahmen Zuschuss',
    category: 'Bundesförderung',
    icon: 'percent',
    description: 'Direkter Zuschuss für energetische Einzelmaßnahmen – kein Kredit, bares Geld vom Staat.',
    details: [
      { label: 'Förderhöhe', value: '15 % der förderfähigen Kosten' },
      { label: 'Mit iSFP-Bonus', value: '20 % (individueller Sanierungsfahrplan)' },
      { label: 'Förderfähige Kosten', value: 'Max. 30.000 € pro Wohneinheit (60.000 € mit iSFP)' },
      { label: 'Antragstellung', value: 'Vor Maßnahmenbeginn über BAFA-Portal (energie-effizienz-experten.de)' },
    ],
    highlights: [
      'Dachdämmung mit U-Wert ≤ 0,14 W/(m²·K)',
      'Fenster und Außentüren',
      'Luftdichtheits- und Dampfsperrsysteme',
    ],
    links: [
      { text: 'BAFA Gebäudehülle: bafa.de/GEG-Gebäudehülle', url: 'https://www.bafa.de/DE/Energie/Effiziente_Gebaeude/Sanierung_Wohngebaeude/Gebaeudehuelle/gebaeudehuelle_node.html' },
    ],
    note: 'Antrag MUSS vor Beginn der Maßnahme gestellt werden. Energieeffizienz-Experte ist Pflicht.'
  },
  {
    title: 'NRW.BANK – Wohnraumförderung Modernisierung',
    category: 'Landesförderung NRW',
    icon: 'map',
    description: 'Günstige Darlehen vom Land Nordrhein-Westfalen mit Tilgungsnachlass – ein Teil des Geldes muss nicht zurückgezahlt werden.',
    details: [
      { label: 'Darlehenshöhe', value: 'Bis zu 220.000 € pro Wohneinheit' },
      { label: 'Tilgungsnachlass', value: '25 % (EKG A) oder 15 % (EKG B) nach Einkommen' },
      { label: 'Bis zu', value: '50 % Tilgungsnachlass mit EKG A + Effizienzhaus-Standard' },
      { label: 'Laufzeit', value: 'Bis zu 35 Jahre, feste Zinsen' },
    ],
    highlights: [
      'Einkommensabhängige Förderung (Einkommensgrenzen prüfen)',
      'Auch für Kölner Altbauten geeignet',
      'Kombinierbar mit KfW-Programmen und BAFA',
    ],
    links: [
      { text: 'NRW.BANK: nrwbank.de/wohneigentum', url: 'https://www.nrwbank.de/de/privatpersonen/wohneigentum/' },
    ],
    note: 'Antrag über die Bewilligungsbehörde (Stadt Köln: Amt für Wohnungswesen). Einkommensgrenzen gelten.'
  },
  {
    title: 'Steuerbonus für Handwerkerleistungen (§ 35c EStG)',
    category: 'Steuerliche Förderung',
    icon: 'percent',
    description: '20 % der Handwerkerkosten direkt von der Steuerschuld abziehen – ohne Förderprogramm.',
    details: [
      { label: 'Steuerbonus', value: '20 % der Arbeitskosten' },
      { label: 'Maximalbetrag', value: '1.200 € pro Jahr (bei 6.000 € Arbeitskosten)' },
      { label: 'Gültig', value: 'Für energetische Maßnahmen an selbstgenutztem Wohneigentum' },
      { label: 'Voraussetzung', value: 'Rechnung mit ausgewiesenen Arbeitskosten, Überweisung' },
    ],
    highlights: [
      'Alternative zur BAFA-Förderung (nicht kombinierbar!)',
      'Antrag im Rahmen der Einkommensteuererklärung',
      'Für alle Handwerkerleistungen rund um den DG-Ausbau',
    ],
    links: [
      { text: '§ 35c EStG: gesetze-im-internet.de/estg/__35c.html', url: 'https://www.gesetze-im-internet.de/estg/__35c.html' },
    ],
    note: 'WICHTIG: Der Steuerbonus kann NICHT mit BAFA- oder KfW-Förderung für dieselbe Maßnahme kombiniert werden. Entweder-oder!'
  },
  {
    title: 'Amt für Wohnungswesen Köln – Kommunale Förderung',
    category: 'Kommunale Förderung',
    icon: 'city',
    description: 'Beratung zu Kölner Eigenheimförderung und Wohnraumförderung des Landes NRW.',
    details: [
      { label: 'Adresse', value: 'Gottfried-Hagen-Str. 46-48, 51105 Köln' },
      { label: 'Telefon', value: '0221 / 221-34641' },
      { label: 'Schwerpunkt', value: 'Wohnraumförderung, Familienförderung, Barrierefreiheit' },
      { label: 'Beratung', value: 'Kostenlose Vor-Ort-Beratung möglich' },
    ],
    highlights: [
      'Prüfung der NRW-Landesförderung (Einkommensgrenzen)',
      'Fördermittel für bezahlbaren Wohnraum',
      'Beratung zu weiteren kommunalen Programmen',
    ],
    links: [
      { text: 'Stadt Köln: stadt-koeln.de/wohnen', url: 'https://www.stadt-koeln.de/leben-in-koeln/wohnen/' },
    ],
    note: 'Die NRW-Landesförderung hat Einkommensgrenzen. Lassen Sie sich beraten, ob Sie infrage kommen.'
  },
];

const kostenbeispiele = [
  { massnahme: 'Dachdämmung (150 m²)', kosten: '18.000 - 27.000 €', foerderung: '2.700 - 5.400 €' },
  { massnahme: 'Gaubeneinbau (1 Stück)', kosten: '12.000 - 25.000 €', foerderung: '1.800 - 5.000 €' },
  { massnahme: 'Fenstererneuerung (8 Stück)', kosten: '8.000 - 16.000 €', foerderung: '1.200 - 3.200 €' },
  { massnahme: 'Heizungsoptimierung', kosten: '2.000 - 5.000 €', foerderung: '400 - 1.000 €' },
  { massnahme: 'Kompletter DG-Ausbau', kosten: '80.000 - 150.000 €', foerderung: '12.000 - 30.000 €' },
];

const faqs = [
  {
    question: 'Kann ich mehrere Förderprogramme gleichzeitig nutzen?',
    answer: 'Grundsätzlich ja – aber nicht für dieselbe Maßnahme. KfW und BAFA schließen sich für die gleiche Maßnahme gegenseitig aus. Sie können aber BAFA für Einzelmaßnahmen (z.B. Dachdämmung) nutzen und KfW 261 für eine Komplettsanierung. Der NRW.BANK-Kredit lässt sich mit beiden kombinieren. Der Steuerbonus (§ 35c EStG) ist alternativ zum BAFA-Zuschuss, nicht zusätzlich. Lassen Sie sich beraten, welche Kombination für Sie optimal ist.'
  },
  {
    question: 'Muss ich den Dachgeschossausbau komplett energetisch sanieren, um Förderung zu bekommen?',
    answer: 'Nein! Einzelmaßnahmen werden ebenfalls gefördert. Über BAFA BEG EM können Sie einzelne Gewerke wie Dachdämmung, Fenstertausch oder die Dampfsperre fördern lassen – ohne das gesamte Gebäude auf Effizienzhaus-Standard zu bringen. Voraussetzung ist ein U-Wert von ≤ 0,14 W/(m²·K) und ein Energieeffizienz-Experte.'
  },
  {
    question: 'Ich kann mich nicht zwischen BAFA und Steuerbonus entscheiden – was ist besser?',
    answer: 'Das hängt von Ihrer Steuerlast ab. Der Steuerbonus bringt Ihnen 20 % von max. 6.000 € = 1.200 € pro Jahr. BAFA gibt 15 % von max. 30.000 € = 4.500 € Zuschuss (einmalig). Bei hohen Handwerkerkosten ist BAFA meist besser, weil der Zuschuss nicht von Ihrer Steuerlast abhängt – Sie bekommen das Geld aufs Konto, unabhängig von Ihrem Einkommen.'
  },
  {
    question: 'Gibt es Förderung für den reinen Wohnraumausbau ohne energetische Komponente?',
    answer: 'Reine Wohnraumerweiterungen ohne energetische Sanierung werden nicht durch KfW oder BAFA gefördert. Allerdings: Wenn Sie im Rahmen des DG-Ausbaus auch dämmen (was das GEG ohnehin fordert), wird die energetische Komponente förderfähig. Die NRW.BANK-Landesförderung kann auch für nicht-energetische Modernisierungen genutzt werden (Einkommensgrenzen prüfen!).'
  },
  {
    question: 'Ich bin Vermieter – kann ich Förderung für den Dachgeschossausbau nutzen?',
    answer: 'Ja! Vermieter können BAFA-Zuschüsse und KfW-Kredite für energetische Maßnahmen nutzen. Der NRW.BANK-Kredit richtet sich allerdings primär an Selbstnutzer. Wichtig: Der Steuerbonus (§ 35c EStG) gilt nur für selbstgenutztes Wohneigentum, nicht für Vermietung. Bei Mietobjekten gelten die üblichen Abschreibungsmöglichkeiten.'
  },
  {
    question: 'Was passiert, wenn ich die Förderung nicht rechtzeitig beantrage?',
    answer: 'BAFA und KfW sind Zuschuss- bzw. Kreditprogramme, die vor Maßnahmenbeginn beantragt werden müssen. Wenn Sie bereits mit den Arbeiten begonnen haben, ist ein nachträglicher Antrag in der Regel NICHT mehr möglich. Planen Sie daher frühzeitig: Erst Beratung und Angebot, dann Förderantrag, dann Auftrag. Bei der NRW.BANK kann in Ausnahmefällen ein vorzeitiger Beginn genehmigt werden – fragen Sie nach.'
  },
];

const schema = {
  "@type": "FAQPage",
  "mainEntity": kostenbeispiele.map(item => ({
    "@type": "Question",
    "name": `Welche Förderung erhalte ich für ${item.massnahme}?`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `Für ${item.massnahme} mit Kosten von ${item.kosten} können Förderungen von ${item.foerderung} beantragt werden. Die genaue Förderhöhe hängt von den gewählten Programmen und dem individuellen Antragszeitpunkt ab.`
    }
  })).concat(faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  })))
};
---

<BaseLayout
  title="Förderungen für Dachgeschossausbau in Köln | KfW, BAFA, NRW.BANK"
  description="Fördermittel für Ihren Dachgeschossausbau in Köln: KfW 261/262, BAFA BEG EM, NRW.BANK. Wir beraten Sie zu allen Förderprogrammen und helfen bei der Antragstellung."
>
  <Header />

  <main>
    <!-- Hero mit Inline-Formular -->
    <section class="bg-gradient-to-br from-teal-700 to-teal-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-teal-200 mb-4">
              <a href="/">Startseite</a> / <span class="text-white">Förderungen</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Förderungen für den Dachgeschossausbau in Köln
            </h1>
            <p class="text-xl text-teal-100 max-w-2xl">
              Staatliche Zuschüsse und zinsgünstige Kredite machen den DG-Ausbau deutlich günstiger. Hier finden Sie, was für Sie infrage kommt.
            </p>
          </div>
          <!-- Kompaktes Leadformular -->
          <div class="bg-white rounded-xl shadow-2xl p-5">
            <h2 class="text-lg font-bold text-slate-800 mb-1">
              Förderung prüfen lassen
            </h2>
            <p class="text-slate-600 text-xs mb-4">
              Wir beraten Sie zu KfW, BAFA und NRW.BANK.
            </p>
            <form class="space-y-3" id="hero-form">
              <input
                type="text"
                name="name"
                required
                placeholder="Name *"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-800 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
              />
              <div class="grid grid-cols-2 gap-3">
                <input
                  type="tel"
                  name="phone"
                  required
                  placeholder="Telefon *"
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-800 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                />
                <input
                  type="text"
                  name="plz"
                  placeholder="PLZ"
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-800 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                />
              </div>
              <select
                name="project-type"
                class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-800 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
              >
                <option value="">Vorhaben auswählen...</option>
                <option value="komplett">Kompletter DG-Ausbau</option>
                <option value="daemmung">Nur Dachdämmung</option>
                <option value="gaube">Gaube einbauen</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
              <button
                type="submit"
                class="w-full bg-teal-500 hover:bg-teal-600 text-white font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-200"
              >
                Förderung prüfen
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <script>
      const form = document.getElementById('hero-form') as HTMLFormElement;
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = form.querySelector('button') as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = 'Wird gesendet...';
          await new Promise(r => setTimeout(r, 1500));
          btn.textContent = 'Gesendet!';
          btn.classList.remove('bg-teal-500', 'hover:bg-teal-600');
          btn.classList.add('bg-green-500');
          setTimeout(() => {
            form.reset();
            btn.disabled = false;
            btn.textContent = 'Förderung prüfen';
            btn.classList.remove('bg-green-500');
            btn.classList.add('bg-teal-500', 'hover:bg-teal-600');
          }, 3000);
        });
      }
    </script>

    <!-- Kostenübersicht -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto content-area">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Förderung nach Maßnahme – so viel ist drin
          </h2>
          <div class="bg-slate-50 rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-slate-100">
                    <th class="text-left px-6 py-4 font-semibold text-slate-800">Maßnahme</th>
                    <th class="text-right px-6 py-4 font-semibold text-slate-800">Kosten (ca.)</th>
                    <th class="text-right px-6 py-4 font-semibold text-teal-600">Förderung (ca.)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {kostenbeispiele.map(item => (
                    <tr class="hover:bg-white transition-colors">
                      <td class="px-6 py-4 text-slate-700">{item.massnahme}</td>
                      <td class="px-6 py-4 text-slate-600 text-right">{item.kosten}</td>
                      <td class="px-6 py-4 text-teal-600 font-semibold text-right">{item.foerderung}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="px-6 py-4 bg-amber-50 border-t border-amber-100">
              <p class="text-sm text-amber-800">
                <strong>Hinweis:</strong> Die angegebenen Förderungen sind Richtwerte und hängen von der aktuellen Förderperiode, dem Antragszeitpunkt und der individuellen Situation ab. Verbindliche Werte erhalten Sie nach einer Beratung.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Förderprogramme -->
    <section class="py-16 md:py-24 bg-slate-50">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Förderprogramme – kurz erklärt
          </h2>
        <div class="space-y-8 max-w-5xl mx-auto">
          {foerderungen.map(programm => (
            <div class="bg-white rounded-2xl shadow-md overflow-hidden">
              <div class="p-6 md:p-8">
                <div class="flex flex-wrap items-start gap-4 mb-4">
                  <span class="inline-flex items-center gap-2 px-3 py-1 bg-teal-100 text-teal-700 rounded-full text-sm font-medium">
                    {programm.category}
                  </span>
                  <h3 class="text-xl md:text-2xl font-bold text-slate-800 flex-1">
                    {programm.title}
                  </h3>
                </div>
                <p class="text-slate-600 mb-6 leading-relaxed">
                  {programm.description}
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                  {programm.details.map(detail => (
                    <div class="flex flex-col">
                      <span class="text-sm text-slate-500 mb-1">{detail.label}</span>
                      <span class="text-slate-800 font-medium">{detail.value}</span>
                    </div>
                  ))}
                </div>
                <div class="bg-slate-50 rounded-xl p-4">
                  <h4 class="font-semibold text-slate-800 mb-2">Das spricht dafür:</h4>
                  <ul class="space-y-1">
                    {programm.highlights.map(highlight => (
                      <li class="flex items-start gap-2 text-slate-600 text-sm">
                        <svg class="w-4 h-4 text-teal-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {highlight}
                      </li>
                    ))}
                  </ul>
                </div>
                {programm.note && (
                  <div class="mt-4 p-4 bg-amber-50 rounded-lg border border-amber-200">
                    <p class="text-sm text-amber-800">
                      <strong>Wichtig:</strong> {programm.note}
                    </p>
                  </div>
                )}
                {programm.links && programm.links.length > 0 && (
                  <div class="mt-4 pt-4 border-t border-slate-100">
                    <p class="text-sm text-slate-500 mb-2">Offizielle Quellen:</p>
                    {programm.links.map(link => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="block text-sm text-teal-600 hover:text-teal-700 hover:underline">
                        → {link.text}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Steuerbonus -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div>
              <span class="inline-flex items-center gap-2 px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-sm font-medium mb-4">
                Steuerbonus
              </span>
              <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">
                20 % Steuerbonus für Handwerkerleistungen
              </h2>
              <p class="text-slate-600 mb-6 leading-relaxed">
                Neben den direkten Zuschüssen und zinsgünstigen Krediten gibt es einen weiteren finanziellen Vorteil: den Steuerbonus für Handwerkerleistungen. Dieser wird direkt von der Steuerschuld abgezogen – nicht von der Steuerlast.
              </p>
              <div class="bg-slate-50 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-slate-600">Maximaler Steuerbonus pro Jahr</span>
                  <span class="text-2xl font-bold text-teal-600">1.200 €</span>
                </div>
                <p class="text-sm text-slate-500">
                  20 % der Arbeitskosten, maximal 6.000 € pro Jahr
                </p>
              </div>
            </div>
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 text-white rounded-2xl p-8">
              <h3 class="text-lg font-bold mb-4">Voraussetzungen für den Steuerbonus</h3>
              <ul class="space-y-3">
                {[
                  'Handwerker muss im Auftrag des Eigentümers arbeiten',
                  'Rechnung muss gesondert ausgewiesene Arbeitskosten enthalten',
                  'Zahlung muss unbar (Überweisung) erfolgen',
                  'Eigenleistungen zählen nicht',
                  'Antragstellung im Rahmen der Einkommensteuererklärung',
                ].map(item => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-teal-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span class="text-slate-200 text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Kombinierbarkeit -->
    <section class="py-16 md:py-24 bg-teal-700 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">
            Förderungen kombinieren – so maximieren Sie Ihren Vorteil
          </h2>
          <p class="text-xl text-teal-100 mb-12 max-w-2xl mx-auto">
            Die gute Nachricht: Sie müssen sich nicht zwischen den Programmen entscheiden. KfW, BAFA und NRW.BANK lassen sich clever kombinieren.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
            <div class="bg-teal-800 rounded-xl p-6">
