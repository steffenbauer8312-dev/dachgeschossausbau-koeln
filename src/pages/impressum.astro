---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Impressum | Dachgeschossausbau Köln"
  description="Impressum und rechtliche Informationen von Dachgeschossausbau Köln"
>
  <Header />

  <main>
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-8">Impressum</h1>

          <div class="content-area">
            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Angaben gemäß § 5 DDG</h2>

            <div class="bg-slate-50 rounded-xl p-6 mb-8">
              <p class="font-semibold text-slate-800 mb-2">Dachgeschossausbau Köln</p>
              <p>Hauptstr. 134<br />51143 Köln</p>
            </div>

            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Kontakt</h2>
            <p>
              Telefon: <a href="tel:+4915216117439" class="text-teal-600 hover:underline">+49 1521 6117439</a><br />
              E-Mail: <a href="mailto:info@dachgeschossausbau-koeln.de" class="text-teal-600 hover:underline">info@dachgeschossausbau-koeln.de</a>
            </p>

            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Geschäftsführung</h2>
            <p>Michael Schneider</p>

            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Berufsbezeichnung und zuständige Kammer</h2>
            <p>
              Zimmerermeister<br />
              Zuständige Handwerkskammer: Handwerkskammer Köln
            </p>

            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Haftungshinweis</h2>
            <p>
              Die Inhalte dieser Website werden mit größtmöglicher Sorgfalt erstellt. Für Richtigkeit, Vollständigkeit und Aktualität kann keine Gewähr übernommen werden. Für eigene Inhalte gelten die gesetzlichen Verantwortlichkeiten; eine allgemeine Pflicht zur Überwachung übermittelter oder gespeicherter fremder Informationen besteht nur im Rahmen der gesetzlichen Vorschriften.
            </p>

            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Verbraucherstreitbeilegung</h2>
            <p>
              Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
            </p>

            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Bildnachweise</h2>
            <p>
              Sofern nicht anders angegeben: Eigene Aufnahmen
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
