---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout title="Dachgeschossausbau in Köln und den Stadtbezirken" description="Dachgeschossausbau in Köln: Welche Bestands- und Standortfragen Eigentümer in Innenstadt, Ehrenfeld, Nippes, Porz und weiteren Stadtbezirken prüfen sollten.">
  <Header />
  <main>
    <section class="bg-slate-900 text-white"><div class="container mx-auto grid max-w-7xl gap-10 px-4 py-12 md:py-16 lg:grid-cols-[1fr_26rem] lg:items-center"><div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Köln und Umgebung</p><h1 class="mt-4 text-4xl font-bold leading-tight md:text-5xl">Dachausbau im passenden Kontext planen</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Die Adresse allein entscheidet nicht über die Machbarkeit. Bausubstanz, Bebauungsplan, Denkmalschutz, Dachform und Zugang sind die wichtigeren Fragen.</p></div><LeadForm variant="inline" formId="lead-district-top" title="Stadtteil und Vorhaben" subtitle="Nennen Sie Lage und Ziel Ihres Projekts." buttonText="Anfrage senden" /></div></section>
    <section class="bg-white py-14 md:py-20"><div class="container mx-auto max-w-4xl px-4"><h2 class="text-3xl font-bold text-slate-900">Was in Kölner Lagen unterschiedlich sein kann</h2><div class="content-area mt-4"><p>In innerstädtischen Altbauquartieren können Gestaltung, Denkmalschutz, enge Baustellenlogistik und bestehende Eigentumsverhältnisse eine größere Rolle spielen. In Einfamilienhausgebieten stehen oft Dachform, Raumhöhe, Tageslicht und die vorhandene Tragkonstruktion im Vordergrund.</p><p>Das sind keine pauschalen Aussagen über einzelne Veedel. Sie zeigen, warum lokalisierte Seiten mit erfundenen Kniestock- oder Kostenwerten keinen belastbaren Mehrwert liefern. Die richtige lokale Seite ist eine sachliche Köln-Seite mit konkreten Ansprechpartnern und einer realen Anfrage.</p></div></div></section>
    <section class="bg-slate-50 py-14"><div class="container mx-auto max-w-7xl px-4"><h2 class="text-3xl font-bold text-slate-900">Prüfpunkte für jedes Stadtgebiet</h2><div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{[
      ['Bestand', 'Dachform, Baujahr, Schäden und vorhandene Unterlagen'],
      ['Baurecht', 'Nutzung, Dachaufbauten, Bebauungsplan und Gestaltung'],
      ['Bauablauf', 'Zugang, Gerüst, Kran, Nachbarschaft und Baustellenlogistik'],
      ['Nutzung', 'Wohnraum, Büro, Bad, Vermietung oder zusätzliche Ebene']
    ].map(([title, text]) => <div class="rounded-2xl bg-white p-6"><h3 class="font-bold text-slate-900">{title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{text}</p></div>)}</div></div></section>
    <LeadForm variant="full" formId="lead-district-bottom" title="Dachausbau in Köln anfragen" subtitle="Stadtteil, Bestand und Ziel reichen für den ersten Kontakt." buttonText="Unverbindlich anfragen" />
  </main>
  <Footer />
</BaseLayout>
