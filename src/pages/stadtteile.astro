---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const stadtteile = [
  {
    name: 'Ehrenfeld',
    slug: 'ehrenfeld',
    bezirk: 'Innenstadt',
    beschreibung: 'Ehrenfeld ist bekannt für seine bunte Mischung aus Altbauten und kreativer Szene. Die Gründerzeitvillen und Krümelkoppelfassaden sind typisch für diesen Veedel.',
    details: {
      haustypen: 'Gründerzeitvillen (1870-1918), Mehrfamilienhäuser mit ausgebauten Dachgeschossen, Reihenhäuser',
      kniestock: '80-120 cm, typisch für Gründerzeitbauten',
      gauben: 'Trapezgauben bevorzugt, Sattelgauben bei denkmalgeschützten Gebäuden',
      besonderheiten: 'Krümelkoppelfassaden, die bei Gauben berücksichtigt werden müssen. Gute Bausubstanz, oft schon saniert.'
    },
    kostenFaktor: 'mittel-hoch',
    popularitaet: 'sehr hoch'
  },
  {
    name: 'Nippes',
    slug: 'nippes',
    bezirk: 'Innenstadt',
    beschreibung: 'Nippes hat einen dörflichen Charakter mitten in der Stadt. Die kleinen Reihenhäuser und die lebendige Nachbarschaft machen den Stadtteil besonders.',
    details: {
      haustypen: 'Reihenhäuser, kleine Mehrfamilienhäuser, villenartige Strukturen',
      kniestock: '60-100 cm, tendenziell niedriger als in Ehrenfeld',
      gauben: 'Kleine Gauben bevorzugt, Sattelgauben passen gut zum dörflichen Charakter',
      besonderheiten: 'Eng bebaute Grundstücke erfordern kreative Lösungen. Kompakte Dachgeschossausbauten sinnvoll.'
    },
    kostenFaktor: 'mittel',
    popularitaet: 'hoch'
  },
  {
    name: 'Lindenthal',
    slug: 'lindenthal',
    bezirk: 'Innenstadt',
    beschreibung: 'Lindenthal ist geprägt von villenartigen Einfamilienhäusern und der Nähe zum Grüngürtel. Beliebt bei Familien, die zentral und trotzdem ruhig wohnen möchten.',
    details: {
      haustypen: 'Villen, Einfamilienhäuser, großzügige Grundstücke mit Garten',
      kniestock: '100-150 cm, oft höher als in anderen Veedeln',
      gauben: 'Großzügige Gauben möglich, Trapezgauben und Sattelgauben üblich',
      besonderheiten: 'Gehobene Bausubstanz, gute Voraussetzungen für hochwertige Ausbauten. Oft schon modernisiert.'
    },
    kostenFaktor: 'hoch',
    popularitaet: 'mittel'
  },
  {
    name: 'Sülz',
    slug: 'sulz',
    bezirk: 'Innenstadt',
    beschreibung: 'Sülz ist ein lebendiges Viertel mit guter Infrastruktur. Die Kombination aus Altbau und neuem Wohnungsbau macht ihn attraktiv für verschiedenste Bedürfnisse.',
    details: {
      haustypen: 'Gründerzeitbauten, Nachkriegsbauten, neuere Eigentumswohnungen',
      kniestock: '70-110 cm, abhängig vom Baujahr',
      gauben: 'Trapezgauben üblich, bei Nachkriegsbauten auch Flachdachgauben',
      besonderheiten: 'Vielfältige Bausubstanz erfordert individuelle Beratung. Nähe zur Uni bringt studentische Nachfrage.'
    },
    kostenFaktor: 'mittel',
    popularitaet: 'hoch'
  },
  {
    name: 'Marienburg',
    slug: 'marienburg',
    bezirk: 'Innenstadt',
    beschreibung: 'Marienburg gehört zu den gehobeneren Wohnlagen in Köln. Die großzügigen Grundstücke und die Nähe zum Rhein machen diesen Stadtteil besonders beliebt.',
    details: {
      haustypen: 'Großvillen, Doppelhaushälften, gehobene Einfamilienhäuser',
      kniestock: '120-180 cm, oft optimale Voraussetzungen',
      gauben: 'Großflächige Gauben möglich, architektonisch anspruchsvolle Lösungen',
      besonderheiten: 'Höhere Grundstückspreise machen den DG-Ausbau besonders wertsteigernd. Gehobene Ausstattung üblich.'
    },
    kostenFaktor: 'sehr hoch',
    popularitaet: 'mittel'
  },
  {
    name: 'Rodenkirchen',
    slug: 'rodenkirchen',
    bezirk: 'Innenstadt',
    beschreibung: 'Rodenkirchen liegt direkt am Rhein und verbindet urbanes Wohnen mit Naherholung. Die Kalker Seen sind in der Nähe.',
    details: {
      haustypen: 'Villen, Mehrfamilienhäuser, Rheinfront-Bebauung',
      kniestock: '90-140 cm, je nach Baualter',
      gauben: 'Trapez- und Sattelgauben, bei Rheinfront auch Sonderlösungen',
      besonderheiten: 'Rheinnähe erfordert Feuchtigkeitsschutz. Schöne Dachlandschaften prägen das Bild.'
    },
    kostenFaktor: 'hoch',
    popularitaet: 'mittel'
  },
  {
    name: 'Deutz',
    slug: 'deutz',
    bezirk: 'Innenstadt',
    beschreibung: 'Deutz hat sich in den letzten Jahren stark entwickelt. Die Trade Show und die Strandpromenade am Rhein ziehen viele Besucher an.',
    details: {
      haustypen: 'Altbau-Mehrfamilienhäuser, neuere Geschossbauten, Gewerbeumbauten',
      kniestock: '60-100 cm, varies stark nach Baujahr',
      gauben: 'Oft Flachdachgauben oder Gauben in modernem Stil',
      besonderheiten: 'Im Wandel begriffener Stadtteil. Neubaugebiete bieten andere Potenziale als der Altbaubestand.'
    },
    kostenFaktor: 'mittel',
    popularitaet: 'mittel'
  },
  {
    name: 'Mülheim',
    slug: 'muelheim',
    bezirk: 'Mülheim',
    beschreibung: 'Mülheim ist ein traditioneller Arbeiterviertel mit eigenem Charakter. Die Einkaufsstraße Clevischer Berg ist ein beliebtes Ziel.',
    details: {
      haustypen: 'Arbeiterwohnungen, Reihenhäuser, gründerzeitliche Mietskasernen',
      kniestock: '60-90 cm, tendenziell niedriger',
      gauben: 'Kleine Gauben bevorzugt, schlichte Ausführungen üblich',
      besonderheiten: 'Günstige Grundstückspreise machen den DG-Ausbau attraktiv. Oft Sanierungsbedarf vorhanden.'
    },
    kostenFaktor: 'niedrig-mittel',
    popularitaet: 'mittel'
  },
  {
    name: 'Kalk',
    slug: 'kalk',
    bezirk: 'Kalk',
    beschreibung: 'Kalk ist ein aufstrebender Stadtteil mit viel Potenzial. Die Nähe zum Messegelände und die gute Verkehrsanbindung machen ihn interessant.',
    details: {
      haustypen: 'Nachkriegsbauten, Altbauquartiere, neuere Geschossbauten',
      kniestock: '70-100 cm, varies',
      gauben: 'Trapezgauben und Flachdachgauben',
      besonderheiten: 'Aufstrebender Bezirk mit Potenzial. Messenähe bringt temporäre Nachfrage für Kurzzeitmiete.'
    },
    kostenFaktor: 'niedrig-mittel',
    popularitaet: 'mittel'
  },
  {
    name: 'Porz',
    slug: 'porz',
    bezirk: 'Porz',
    beschreibung: 'Porz ist ein großer Stadtteil am Rhein mit vielfältiger Bausubstanz. Von Reihenhäusern bis zu großen Mietskasernen ist alles vertreten.',
    details: {
      haustypen: 'Große Mietskasernen, Reihenhäuser, Einfamilienhausgebiete, Rheinbebauung',
      kniestock: '60-120 cm, stark variierend',
      gauben: 'Alle Gaubenformen möglich, von schlicht bis aufwendig',
      besonderheiten: 'Unser Standort – wir kennen Porz wie kein anderer. Vielfältige Bausubstanz erfordert Erfahrung.'
    },
    kostenFaktor: 'niedrig-mittel',
    popularitaet: 'hoch'
  },
  {
    name: 'Chorweiler',
    slug: 'chorweiler',
    bezirk: 'Chorweiler',
    beschreibung: 'Chorweiler ist eine der großen Neubausiedlungen in Köln. Hier gibt es besonders viele Potenziale für Dachgeschossausbauten.',
    details: {
      haustypen: 'Großflächige Neubausiedlungen, Geschossbauten aus den 60er/70er Jahren',
      kniestock: '80-110 cm, oft ausreichend',
      gauben: 'Flachdachgauben oder moderne Gaubenlösungen',
      besonderheiten: 'Großes Potenzial durch viele flache Dächer. Teilweise bereits DG ausgebaut, teilweise noch Ausbaupotenzial.'
    },
    kostenFaktor: 'niedrig',
    popularitaet: 'mittel'
  },
  {
    name: 'Innenstadt',
    slug: 'innenstadt',
    bezirk: 'Innenstadt',
    beschreibung: 'Die Kölner Innenstadt bietet viele Altbauten mit ausbaufähigen Dachböden. Besonders die engen Gassen und das historische Viertel sind interessant.',
    details: {
      haustypen: 'Historische Altbauten, Fachwerkhäuser, Gründerzeitfassaden',
      kniestock: '70-100 cm, varies stark',
      gauben: 'Bei denkmalgeschützten Gebäuden oft Auflagen. Kreative Lösungen nötig.',
      besonderheiten: 'Denkmalschutz spielt eine wichtige Rolle. Bei Gauben sind Auflagen zu beachten.'
    },
    kostenFaktor: 'hoch',
    popularitaet: 'niedrig'
  },
  {
    name: 'Neuehrenfeld',
    slug: 'neuehrenfeld',
    bezirk: 'Innenstadt',
    beschreibung: 'Neuehrenfeld ist ein Veedel im Wandel. Die Altbauten werden zunehmend saniert, und der Dachgeschossausbau erfreut sich wachsender Beliebtheit.',
    details: {
      haustypen: 'Gründerzeitbauten, Nachkriegsbauten, sanierte Altbauten',
      kniestock: '70-110 cm, varies',
      gauben: 'Trapezgauben üblich, bei Sanierungen oft großzügig dimensioniert',
      besonderheiten: 'Aufstrebendes Veedel mit Sanierungswelle. Gute Voraussetzungen für den DG-Ausbau.'
    },
    kostenFaktor: 'mittel',
    popularitaet: 'hoch'
  },
  {
    name: 'Bickendorf',
    slug: 'bickendorf',
    bezirk: 'Innenstadt',
    beschreibung: 'Bickendorf hat sich von einem alten Arbeiterviertel zu einem beliebten Wohnviertel entwickelt. Die Bausubstanz bietet gute Möglichkeiten.',
    details: {
      haustypen: 'Reihenhäuser, Mehrfamilienhäuser, Villen aus den 50er/60er Jahren',
      kniestock: '80-120 cm',
      gauben: 'Moderate Gaubenformate, Sattelgauben passen gut',
      besonderheiten: 'Gewachsene Struktur mit guten Ausbaumöglichkeiten. Nähe zu Park und guter Infrastruktur.'
    },
    kostenFaktor: 'mittel',
    popularitaet: 'mittel'
  },
  {
    name: 'Ossendorf',
    slug: 'ossendorf',
    bezirk: 'Innenstadt',
    beschreibung: 'Ossendorf ist ein ruhiger Stadtteil mit vielen Einfamilienhäusern. Die Kombination aus Bestandsbauten und neuen Siedlungen macht ihn vielseitig.',
    details: {
      haustypen: 'Einfamilienhäuser, Reihenhäuser, neuer Wohnungsbau',
      kniestock: '90-130 cm',
      gauben: 'Alle Formen möglich, gute Voraussetzungen für Gauben',
      besonderheiten: 'Ruhiges Veedel mit viel Eigenheimcharakter. DG-Ausbau hier besonders wertsteigernd.'
    },
    kostenFaktor: 'mittel',
    popularitaet: 'niedrig'
  },
  {
    name: 'Longerich',
    slug: 'longerich',
    bezirk: 'Innenstadt',
    beschreibung: 'Longerich liegt im Norden der Stadt und hat einen ländlichen Charakter. Die vielen Reihenhäuser bieten Potenzial für Dachgeschossausbauten.',
    details: {
      haustypen: 'Reihenhäuser, Einfamilienhäuser, villenartige Strukturen',
      kniestock: '80-110 cm',
      gauben: 'Kleine bis mittlere Gauben, Sattelgauben üblich',
      besonderheiten: 'Ländlicher Charakter trotz Stadtlage. Gute Infrastruktur, familienfreundlich.'
    },
    kostenFaktor: 'niedrig-mittel',
    popularitaet: 'niedrig'
  },
  {
    name: 'Pesch',
    slug: 'pesch',
    bezirk: 'Chorweiler',
    beschreibung: 'Pesch ist Teil der großen Neubausiedlung Chorweiler. Hier gibt es besonders viele flache Dächer, die für Ausbauten interessant sind.',
    details: {
      haustypen: 'Geschossbauten aus den 60er/70er Jahren, Reihenhäuser',
      kniestock: '70-100 cm',
      gauben: 'Flachdachgauben oder moderne Lösungen',
      besonderheiten: 'Teil der Chorweiler Siedlung. Oft WGH-Besitz, wobei Eigentumswohnungen ausgebaut werden können.'
    },
    kostenFaktor: 'niedrig',
    popularitaet: 'niedrig'
  },
  {
    name: 'Lindweiler',
    slug: 'lindweiler',
    bezirk: 'Chorweiler',
    beschreibung: 'Lindweiler liegt am Rande von Köln und hat einen dörflichen Charakter. Die Bausubstanz ist überwiegend aus den 1970er Jahren.',
    details: {
      haustypen: 'Einfamilienhäuser, Reihenhäuser, kleiner Geschosswohnungsbau',
      kniestock: '80-100 cm',
      gauben: 'Schlichte Gaubenformate, moderne Lösungen bevorzugt',
      besonderheiten: 'Dörflicher Charakter am Stadtrand. Oft kleiner dimensionierte Dächer.'
    },
    kostenFaktor: 'niedrig',
    popularitaet: 'niedrig'
  },
];

const bezirke = [...new Set(stadtteile.map(s => s.bezirk))];

const schema = {
  "@type": "CollectionPage",
  "about": {
    "@type": "City",
    "name": "Köln"
  },
  "mainEntity": stadtteile.map(s => ({
    "@type": "Place",
    "name": `${s.name}, Köln`,
    "containedInPlace": {
      "@type": "City",
      "name": "Köln"
    }
  }))
};
---

<BaseLayout
  title="Kölner Stadtteile | Dachgeschossausbau in ganz Köln"
  description="Dachgeschossausbau in allen Kölner Stadtteilen: Ehrenfeld, Nippes, Lindenthal, Marienburg und mehr. Wir kennen die Eigenheiten jedes Veedels."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">
          Dachgeschossausbau – jeder Kölner Stadtteil anders
        </h1>
        <p class="text-xl text-slate-300 max-w-2xl">
          Ehrenfeld, Nippes, Porz, Chorweiler – jedes Veedel hat seine Eigenheiten. Wir kennen sie alle.
        </p>
      </div>
    </section>

    <!-- Einleitung -->
    <section class="py-12 bg-white border-b border-slate-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <p class="text-lg text-slate-600 leading-relaxed">
            Jedes Veedel hat seinen eigenen Baustil. Mal hohe Kniestöcke, mal niedrige Satteldächer. Mal Denkmalschutz, mal freie Hand. Wir wissen, was in Ehrenfeld geht und was in Chorweiler nicht geht.
          </p>
        </div>
      </div>
    </section>

    <!-- Stadtteile nach Bezirken -->
    {bezirke.map((bezirk, bezirkIndex) => (
      <section class="py-16 bg-slate-50">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-bold text-slate-800 mb-8 flex items-center gap-3">
            <span class="w-8 h-8 bg-teal-500 rounded-lg flex items-center justify-center text-white text-sm font-bold">{bezirkIndex + 1}</span>
            {bezirk}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {stadtteile.filter(s => s.bezirk === bezirk).map(stadtteil => (
              <div id={stadtteil.slug} class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                <div class="p-6">
                  <div class="flex items-start justify-between mb-4">
                    <div>
                      <h3 class="text-xl font-bold text-slate-800">{stadtteil.name}</h3>
                      <p class="text-teal-600 text-sm">{stadtteil.bezirk}</p>
                    </div>
                    <span class={`inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium ${
                      stadtteil.popularitaet === 'sehr hoch' ? 'bg-teal-100 text-teal-700' :
                      stadtteil.popularitaet === 'hoch' ? 'bg-blue-100 text-blue-700' :
                      'bg-slate-100 text-slate-600'
                    }`}>
                      {stadtteil.popularitaet === 'sehr hoch' ? '🔥' : stadtteil.popularitaet === 'hoch' ? '⭐' : '📍'} {stadtteil.popularitaet}
                    </span>
                  </div>

                  <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    {stadtteil.beschreibung}
                  </p>

                  <div class="space-y-3 text-sm">
                    <div class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                      <div>
                        <span class="text-slate-500">Häuser:</span>
                        <span class="text-slate-700 ml-1">{stadtteil.details.haustypen}</span>
                      </div>
                    </div>
                    <div class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
                      </svg>
                      <div>
                        <span class="text-slate-500">Kniestock:</span>
                        <span class="text-slate-700 ml-1">{stadtteil.details.kniestock}</span>
                      </div>
                    </div>
                    <div class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                      </svg>
                      <div>
                        <span class="text-slate-500">Gauben:</span>
                        <span class="text-slate-700 ml-1">{stadtteil.details.gauben}</span>
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 pt-4 border-t border-slate-100">
                    <p class="text-slate-600 text-sm">
                      <span class="font-medium text-slate-700">Besonderheiten:</span> {stadtteil.details.besonderheiten}
                    </p>
                  </div>

                  <div class="mt-4 flex items-center justify-between">
                    <span class={`text-xs px-2 py-1 rounded ${
                      stadtteil.kostenFaktor === 'niedrig' ? 'bg-green-100 text-green-700' :
                      stadtteil.kostenFaktor === 'niedrig-mittel' ? 'bg-green-100 text-green-700' :
                      stadtteil.kostenFaktor === 'mittel' ? 'bg-yellow-100 text-yellow-700' :
                      stadtteil.kostenFaktor === 'mittel-hoch' ? 'bg-orange-100 text-orange-700' :
                      stadtteil.kostenFaktor === 'hoch' || stadtteil.kostenFaktor === 'sehr hoch' ? 'bg-red-100 text-red-700' :
                      'bg-red-100 text-red-700'
                    }`}>
                      Kostenfaktor: {stadtteil.kostenFaktor}
                    </span>
                    <a href="/kontakt" class="text-teal-600 text-sm font-medium hover:text-teal-700">
                      Beratung anfragen →
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- Service-Hinweis -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">
            Ihr Stadtteil ist nicht dabei?
          </h2>
          <p class="text-slate-600 max-w-2xl mx-auto mb-8">
            Kein Problem – wir sind in ganz Köln unterwegs. Von Chorweiler bis Marienburg, von Deutz bis Lindenthal. Sprechen Sie uns an, und wir finden eine Lösung für Ihr Projekt.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/kontakt" class="inline-flex items-center gap-2 bg-teal-500 hover:bg-teal-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200">
              Kontakt aufnehmen
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a href="tel:+4915216117439" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-6 py-3 rounded-lg transition-colors duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +49 1521 6117439
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Förderungen-Hinweis -->
    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="bg-gradient-to-r from-teal-500 to-teal-600 text-white rounded-2xl p-8 md:p-12 text-center">
            <h2 class="text-2xl md:text-3xl font-bold mb-4">
              Fördermittel für Ihren Dachgeschossausbau
            </h2>
            <p class="text-xl text-teal-100 mb-8 max-w-2xl mx-auto">
              Nutzen Sie KfW, BAFA und NRW.BANK-Förderung für Ihr Projekt in Köln. Wir beraten Sie zu allen Möglichkeiten.
            </p>
            <a href="/foerderungen" class="inline-flex items-center gap-2 bg-white text-teal-600 font-semibold px-6 py-3 rounded-lg hover:bg-teal-50 transition-colors duration-200">
              Förderungen entdecken
