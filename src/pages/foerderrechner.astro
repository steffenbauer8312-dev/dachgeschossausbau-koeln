                `<div class="prog-section-title">Voraussetzungen</div>` +
                `<ul class="prog-cond">${bedingungenHtml}</ul>` +
              `</div>` +
              `<div class="prog-section">` +
                comboBadge +
                `<p class="prog-cond" style="margin-top:6px;font-style:italic">${p.kombiText}</p>` +
              `</div>` +
              `<div class="source-links">${linksHtml}</div>` +
            `</div>`;
        });
    }
  }

  recalc();
</script>