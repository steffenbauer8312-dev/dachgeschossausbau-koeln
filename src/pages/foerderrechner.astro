    if (S.komplettsanierung && !S.energieberater) warns.push('KfW 261 erfordert zwingend Fachplanung und Baubegleitung durch einen EEE.');

    const warnBox = document.getElementById('warnBox');
    if (warnBox) {
      warnBox.innerHTML = warns.map(w => `<div class="warn">${iconWarn}<span>${w}</span></div>`).join('');
    }

    const progs = [
