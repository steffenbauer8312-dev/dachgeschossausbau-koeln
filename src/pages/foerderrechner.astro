    const list = document.getElementById('progList');
    if (list) {
      list.innerHTML = '';
      progs
        .filter((p: any) => activeTab === 'alle' || p.ebene === activeTab)
        .forEach((p: any) => {
          const cls = p.active ? 'active' : 'inactive';
          const comboBadge = p.kombi
            ? `<span class="combo-badge combo-yes">${iconCheck} Kombinierbar</span>`
            : `<span class="combo-badge combo-no">${iconX} Nicht kombinierbar mit BAFA/KfW</span>`;
          const betragText = p.betrag > 0
            ? fmt(p.betrag)
            : (p.id === 'kfw261' && p.active ? '(Kredit + Tilgungszuschuss)' : 'nicht anwendbar');
          const linksHtml = p.links
            .map((l: any) => `<a class="source-link" href="${l.url}" target="_blank" rel="noopener noreferrer">${iconLink} ${l.label}</a>`)
            .join('');
          const bedingungenHtml = p.bedingungen
            .map((b: string) => `<li>${b}</li>`)
            .join('');

          list.innerHTML +=
            `<div class="prog-item ${cls}">` +
              `<div class="prog-header">` +
                `<div class="prog-header-left">` +
                  `<span class="prog-name">${p.name}</span>` +
