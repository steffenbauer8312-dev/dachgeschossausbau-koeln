---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import FAQ from '../components/FAQ.astro';
import CostTable from '../components/CostTable.astro';
import ContactForm from '../components/ContactForm.astro';

const heroHeadline = 'Dachgeschossausbau Köln – Wohnraum gewinnen über den Dächern der Stadt';
const heroSubline = 'Wir bauen Dachgeschosse in Köln aus – mit eigenen Leuten, seit vielen Jahren. Ein Ansprechpartner für alles: Statik, Dämmung, Gauben, Innenausbau.';

const services = [
  {
    title: 'Bestandsaufnahme & Statik',
    description: 'Wir prüfen die vorhandene Bausubstanz, berechnen die Statik und klären, welche Maßnahmen für Ihren Dachgeschossausbau in Köln notwendig sind.',
    icon: '<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>',
    href: '/leistungen/statik'
  },
  {
    title: 'Dachgauben',
    description: 'Dachgauben schaffen zusätzlichen Raum und Licht. Wir planen und bauen Gauben, die zum Stil Ihres Hauses passen und mehr Wohnfläche unter dem Dach ermöglichen.',
    icon: '<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>',
    href: '/leistungen/gauben'
  },
  {
    title: 'Dachdämmung nach GEG',
    description: 'Das Gebäudeenergiegesetz (GEG) schreibt bestimmte Dämmstandards vor. Wir sorgen dafür, dass Ihr Dachgeschossausbau in Köln alle gesetzlichen Anforderungen erfüllt.',
    icon: '<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>',
    href: '/leistungen/daemmung'
  },
  {
    title: 'Trockenbau',
    description: 'Gipskartonplatten, Zwischenwände, Abhangdecken – unser Trockenbau-Team schafft die Struktur für Ihren neuen Wohnraum im Dachgeschoss.',
    icon: '<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>',
    href: '/leistungen/trockenbau'
  },
  {
    title: 'Elektro & Heizung',
    description: 'Von der Verteilerdose bis zum Heizungsanschluss: Wir koordinieren alle technischen Gewerke für Ihren Dachgeschossausbau in Köln.',
    icon: '<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>',
    href: '/leistungen/statik'
  },
  {
    title: 'Maler- & Bodenbelagsarbeiten',
    description: 'Damit Sie Ihr neues Dachgeschoss in Köln sofort nutzen können, übernehmen wir auch die Feinarbeiten: Tapezieren, Streichen, Bodenbelag.',
    icon: '<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>',
    href: '/leistungen/bad'
  }
];

const costItems = [
  { measure: 'Rückbau bestehender Verkleidungen', unit: 'm²', from: '30 €', to: '65 €' },
  { measure: 'Dämmung Zwischensparren', unit: 'm²', from: '60 €', to: '100 €' },
  { measure: 'Dampfsperre / Luftdichtung', unit: 'm²', from: '18 €', to: '28 €' },
  { measure: 'Trockenbau Dachschrägen', unit: 'm²', from: '48 €', to: '78 €' },
  { measure: 'Bodenaufbau', unit: 'm²', from: '70 €', to: '135 €' },
  { measure: 'Elektroinstallation komplett', unit: 'm²', from: '80 €', to: '145 €' },
  { measure: 'Heizungsanschluss', unit: 'pauschal', from: '2.000 €', to: '5.000 €' },
  { measure: 'Malerarbeiten', unit: 'm²', from: '14 €', to: '24 €' }
];

const faqs = [
  {
    question: 'Was kostet ein Dachgeschossausbau in Köln?',
    answer: 'Kommt drauf an. Wohnfläche, Zustand des Daches, Ausstattung – alles fließt ein. Unsere Richtwerte: 1.200 bis 2.500 Euro pro Quadratmeter. Für 50 Quadratmeter rechnen Sie mit 60.000 bis 125.000 Euro. Das klingt viel, ist aber unter dem Strich eine Menge Wohnraum.'
  },
  {
    question: 'Brauche ich eine Genehmigung für den Dachausbau in Köln?',
    answer: 'Ja. In Köln brauchen Sie immer eine Baugenehmigung für den DG-Ausbau – auch für Gauben. Das Bauaufsichtsamt ist zuständig. Wir übernehmen die Antragstellung.'
  },
  {
    question: 'Wie hoch muss der Kniestock sein?',
    answer: 'Mindestens 1,20 Meter, damit man vernünftig stehen kann. Viele Kölner Altbauten haben weniger. Mit einer Gaube kriegen Sie aber auch dann nutzbaren Raum hin.'
  },
  {
    question: 'Welche Dämmung schreibt das Gesetz vor?',
    answer: 'Das GEG fordert einen U-Wert von höchstens 0,14 W/(m²K). Das erreichen wir mit Zwischensparren- und Untersparren-Dämmung. Bei KfW-Förderung werden die Anforderungen strenger.'
  },
  {
    question: 'Wie lange dauert der Ausbau?',
    answer: '8 bis 16 Wochen für den Bau selbst. Dazu kommen 4 bis 8 Wochen für die Genehmigung. Insgesamt sollten Sie mit 3 bis 4 Monaten rechnen.'
  },
  {
    question: 'Wird es im Sommer nicht unerträglich heiß unterm Dach?',
    answer: 'Nicht mit richtiger Dämmung. Wir setzen auf eine luftdichte, diffusionsoffene Konstruktion mit Sonnenschutz. Optional gibt es auch Dachbegrünung oder elektrische Verschattung.'
  },
  {
    question: 'Kann ich den Ausbau steuerlich absetzen?',
    answer: '20 Prozent der Handwerkerkosten gehen direkt von der Steuerlast ab – bis zu 1.200 Euro pro Jahr. KfW-Förderung geht auch. Lassen Sie sich von Ihrem Steuerberater beraten.'
  },
  {
    question: 'Gibt es geschützte Tiere im Dach?',
    answer: 'Kann sein. Fledermäuse und Vögel sind im Rheinland öfter mal in Dachböden. Vor dem Start muss eine ökologische Bestandsaufnahme ran. Wenn was drin ist, gibt es Auflagen vom Amt.'
  },
  {
    question: 'Brauche ich einen Architekten?',
    answer: 'Nicht immer. Bei einfachen Ausbauten reichen wir. Bei komplexen Projekten, Gauben oder Förderanträgen empfehlen wir einen Architekten. Wir arbeiten mit Partnern zusammen.'
  },
  {
    question: 'Welche Gewerke sind involved?',
    answer: 'Zimmerei, Dachdecker, Dämmung, Statik, Trockenbau, Elektro, Heizung, Sanitär, Maler. Bei uns koordiniert das einer – Sie haben einen Ansprechpartner von Anfang bis Ende.'
  }
];

const serviceSchema = {
  "@type": "Service",
  "serviceType": "Dachgeschossausbau",
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Dachgeschossausbau Köln",
    "telephone": "+4915216117439"
  },
  "areaServed": {
    "@type": "City",
    "name": "Köln"
  },
  "description": "Professioneller Dachgeschossausbau in Köln – von der Statik bis zum schlüsselfertigen Wohnraum."
};
---

<BaseLayout
  title="Dachgeschossausbau Köln | Professionell, aus einer Hand, fix verbindlich"
  description="Wir bauen Dachgeschosse in Köln aus – mit eigenen Leuten, seit vielen Jahren. Ein Ansprechpartner für alles: Statik, Dämmung, Gauben, Innenausbau. Aufgeräumt übergeben. Festpreis, fester Termin."
>
  <Header />

  <main>
    <!-- Hero Section mit Leadformular -->
  <section class="relative bg-gradient-to-br from-slate-800 via-slate-900 to-slate-800 text-white overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="container mx-auto px-4 py-16 md:py-24 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Linke Spalte: Headline & CTA -->
        <div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
            {heroHeadline}
          </h1>
          <p class="text-lg md:text-xl text-slate-300 mb-8 leading-relaxed">
            {heroSubline}
          </p>
          <div class="hidden lg:flex flex-wrap gap-4">
            <a
              href="/leistungen"
              class="inline-flex items-center gap-2 border-2 border-white hover:bg-white hover:text-slate-800 text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200"
            >
              Unsere Leistungen
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/kontakt"
              class="inline-flex items-center gap-2 border-2 border-teal-400 text-teal-400 hover:bg-teal-400 hover:text-slate-800 font-semibold px-6 py-3 rounded-lg transition-all duration-200"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {heroHeadline}
            </a>
          </div>
        </div>

        <!-- Rechte Spalte: Kompaktes Leadformular -->
        <div class="bg-white rounded-xl shadow-2xl p-6 md:p-8">
          <h2 class="text-xl font-bold text-slate-800 mb-2">
            Kostenlose Beratung anfragen
          </h2>
          <p class="text-slate-600 text-sm mb-6">
            Wir melden uns innerhalb von 24 Stunden bei Ihnen.
          </p>

          <form class="space-y-4" id="hero-contact-form">
            <div>
              <input
                type="text"
                name="name"
                required
                placeholder="Ihr Name *"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200 text-sm"
              />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <input
                  type="tel"
                  name="phone"
                  required
                  placeholder="Telefon *"
                  class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200 text-sm"
                />
              </div>
              <div>
                <input
                  type="text"
                  name="plz"
                  placeholder="PLZ (Köln)"
                  pattern="[0-9]{5}"
                  class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200 text-sm"
                />
              </div>
            </div>
            <div>
              <select
                name="project-type"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200 text-sm"
              >
                <option value="">Art des Vorhabens...</option>
                <option value="wohnraumausbau">Wohnraumausbau im Dachgeschoss</option>
                <option value="dachgaube">Einbau einer Dachgaube</option>
                <option value="daemmung">Dachdämmung (GEG)</option>
                <option value="komplett">Kompletter Dachgeschossausbau</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>
            <div>
              <textarea
                name="message"
                rows={3}
                placeholder="Beschreiben Sie kurz Ihr Vorhaben..."
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200 resize-none text-sm"
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-teal-500 hover:bg-teal-600 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              Jetzt Beratung anfragen
            </button>
            <p class="text-xs text-slate-500 text-center">
              Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="text-teal-600 hover:underline">Datenschutzerklärung</a> zu.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    const heroForm = document.getElementById('hero-contact-form') as HTMLFormElement;
    if (heroForm) {
      heroForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const button = heroForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        button.disabled = true;
        button.innerHTML = `
          <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Wird gesendet...
        `;
        await new Promise(resolve => setTimeout(resolve, 1500));
        button.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Anfrage gesendet!
        `;
        button.classList.remove('bg-teal-500', 'hover:bg-teal-600');
        button.classList.add('bg-green-500');
        setTimeout(() => {
          heroForm.reset();
          button.disabled = false;
          button.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            Jetzt Beratung anfragen
          `;
          button.classList.remove('bg-green-500');
          button.classList.add('bg-teal-500', 'hover:bg-teal-600');
        }, 3000);
      });
    }
  </script>

    <!-- Über uns Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
              Warum Sie zu uns kommen sollten
            </h2>
            <div class="space-y-4 text-slate-600 leading-relaxed">
              <p>
                Wir sitzen in Köln-Porz und bauen seit über 15 Jahren Dachgeschosse aus. In dieser Zeit haben wir viele Veedel kennengelernt – Ehrenfeld mit seinen Krümelkoppelfassaden, Nippes mit den engen Reihenhausstraßen, Lindenthal mit den Villen am Grüngürtel. Jedes Viertel hat seine Eigenheiten. Und wir kennen sie alle.
              </p>
              <p>
                Bei uns arbeiten feste Teams. Das heißt: Wenn wir bei Ihnen anfangen, kommen dieselben Leute jeden Tag. Kein Wechsel zwischen Subunternehmern, kein "das muss ich erst mal nachfragen". Ein Ansprechpartner von Anfang bis Ende.
              </p>
              <p>
                Wir machen alles selbst: Statik, Dämmung, Gauben, Trockenbau, Elektro, Heizung, Sanitär. Keine externen Abstimmungen, die ewig dauern. Sie haben eine Frage – wir haben die Antwort.
              </p>
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/ueber-uns" class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-700 transition-colors duration-200">
                Mehr über uns
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <a href="/kontakt" class="inline-flex items-center gap-2 bg-teal-500 hover:bg-teal-600 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors duration-200">
                Erstgespräch vereinbaren
              </a>
            </div>
          </div>
          <div class="bg-slate-100 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-slate-800 mb-4">Unsere Erfahrung in Zahlen</h3>
            <div class="grid grid-cols-2 gap-6">
              <div>
                <p class="text-3xl font-bold text-teal-600">150+</p>
                <p class="text-slate-600 text-sm">Projekte in Köln</p>
              </div>
              <div>
                <p class="text-3xl font-bold text-teal-600">15</p>
                <p class="text-slate-600 text-sm">Jahre Erfahrung</p>
              </div>
              <div>
                <p class="text-3xl font-bold text-teal-600">98%</p>
                <p class="text-slate-600 text-sm">Kundenzufriedenheit</p>
              </div>
              <div>
                <p class="text-3xl font-bold text-teal-600">1</p>
                <p class="text-slate-600 text-sm">Ansprechpartner</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- So arbeiten wir -->
    <section class="py-16 md:py-24 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">
            So läuft ein Projekt bei uns ab
          </h2>
          <p class="text-slate-600 max-w-2xl mx-auto">
            Drei Schritte. Mehr Komplexität brauchen wir nicht.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl p-6 shadow-md relative">
            <div class="absolute -top-4 left-6 w-8 h-8 bg-teal-500 rounded-full flex items-center justify-center text-white font-bold">1</div>
            <h3 class="text-xl font-bold text-slate-800 mb-3 mt-2">Beratung vor Ort</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Wir schauen uns das Dach an. Sie erzählen uns, was Sie sich vorstellen. Direkt vor Ort sagen wir Ihnen, was geht und was es kostet. Kein Verkaufsgespräch, keine Überraschungen.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-md relative">
            <div class="absolute -top-4 left-6 w-8 h-8 bg-teal-500 rounded-full flex items-center justify-center text-white font-bold">2</div>
            <h3 class="text-xl font-bold text-slate-800 mb-3 mt-2">Festpreis-Angebot</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Sie bekommen ein Angebot mit allen Positionen. Keine Nachträge hinterher. Wenn Sie zustimmen, tragen wir den Termin ein. Punkt.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-md relative">
            <div class="absolute -top-4 left-6 w-8 h-8 bg-teal-500 rounded-full flex items-center justify-center text-white font-bold">3</div>
            <h3 class="text-xl font-bold text-slate-800 mb-3 mt-2">Bauen und fertig</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Wir kümmern uns um alle Gewerke. Sie müssen nur noch die Schlüssel abholen, wenn alles fertig ist. So einfach kann das sein.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Zielgruppen -->
    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-slate-800 to-slate-900 text-white rounded-2xl p-8">
            <div class="w-12 h-12 bg-teal-500 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
