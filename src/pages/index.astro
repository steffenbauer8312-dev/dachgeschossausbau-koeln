---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import { services, guides } from '../data/site';

const featured = services.slice(0, 6);
const faqs = [
  { question: 'Was sollte vor einem Dachgeschossausbau geprüft werden?', answer: 'Dachkonstruktion, Decke, Feuchte, Raumhöhe, Belichtung, Rettungswege, Wärme- und Schallschutz sowie die baurechtliche Einordnung. Fotos und Bestandspläne helfen bei einer ersten Orientierung.' },
  { question: 'Ist ein Dachgeschossausbau in Köln genehmigungspflichtig?', answer: 'Das ist vom konkreten Umfang abhängig. Neue Aufenthaltsräume, Nutzungsänderungen, Dachaufbauten, Änderungen der äußeren Gestalt und örtliche Vorgaben können eine Prüfung oder ein Genehmigungsverfahren auslösen.' },
  { question: 'Wie finde ich heraus, ob mein Dachgeschoss geeignet ist?', answer: 'Mit einer Bestandsaufnahme von Dachstuhl, Decke, Dachaufbau, Leitungswegen und Zugang. Eine pauschale Eignung lässt sich aus Baujahr oder Wohnfläche allein nicht ableiten.' }
];
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Dachgeschossausbau Köln', about: { '@type': 'Thing', name: 'Dachgeschossausbau in Köln' } };
---

<BaseLayout title="Dachgeschossausbau Köln | Dachausbau planen" description="Dachgeschossausbau und Dachausbau in Köln sachlich planen: Bestandsprüfung, Statik, Dämmung, Gauben, Dachfenster und Innenausbau.">
  <Header />
  <main>
    <section class="bg-slate-900 text-white">
      <div class="container mx-auto grid max-w-7xl gap-10 px-4 py-12 md:py-16 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Dachausbau in Köln</p>
          <h1 class="max-w-3xl text-4xl font-bold leading-tight md:text-6xl">Dachgeschossausbau in Köln sinnvoll planen</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Vom ungenutzten Dachraum bis zur zusätzlichen Wohnfläche: Hier finden Sie die relevanten Prüfpunkte für Bestand, Planung, Baurecht und Ausbau.</p>
          <div class="mt-7 flex flex-wrap gap-3 text-sm text-slate-300"><span class="rounded-full border border-slate-600 px-3 py-1.5">Bestand zuerst</span><span class="rounded-full border border-slate-600 px-3 py-1.5">Köln und Umgebung</span><span class="rounded-full border border-slate-600 px-3 py-1.5">Quellenbasiert</span></div>
        </div>
        <LeadForm variant="inline" formId="lead-home-top" title="Vorhaben kurz einordnen" subtitle="Eckdaten genügen für den ersten Kontakt." buttonText="Anfrage senden" />
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="container mx-auto max-w-7xl px-4">
        <div class="max-w-3xl"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Der erste sinnvolle Schritt</p><h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">Nicht jedes Dach braucht dieselbe Lösung</h2><p class="mt-5 text-lg leading-relaxed text-slate-600">Ob Ausbau, Aufstockung, Gaube oder energetische Sanierung passt, hängt vom Gebäude und vom Ziel ab. Die Seite trennt deshalb die wichtigsten Wege, statt dieselbe Antwort auf jede Suchanfrage zu geben.</p></div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{featured.map(service => <a href={`/leistungen/${service.slug}/`} class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:border-teal-400 hover:bg-teal-50"><p class="text-sm font-semibold text-teal-700">{service.eyebrow}</p><h3 class="mt-3 text-xl font-bold text-slate-900 group-hover:text-teal-900">{service.title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{service.description}</p><span class="mt-5 inline-block text-sm font-semibold text-teal-700">Details ansehen →</span></a>)}</div>
      </div>
    </section>

    <section class="bg-slate-50 py-14 md:py-20">
      <div class="container mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
        <div><p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Ablauf</p><h2 class="mt-3 text-3xl font-bold text-slate-900">Von der Idee zur belastbaren Entscheidung</h2><p class="mt-5 leading-relaxed text-slate-600">Eine gute Anfrage spart später Rückfragen. Sie beginnt mit dem Gebäude, nicht mit einem pauschalen Preisversprechen.</p></div>
        <ol class="space-y-5">{[
          ['01', 'Bestand beschreiben', 'Fotos, Pläne, Baujahr, Dachform und das gewünschte Raumprogramm zusammentragen.'],
          ['02', 'Machbarkeit einordnen', 'Tragwerk, Dämmung, Tageslicht, Zugang, Technik und rechtliche Fragen gemeinsam betrachten.'],
          ['03', 'Nächste Planung festlegen', 'Klären, welche Unterlagen, Fachplanungen und Abstimmungen für das konkrete Projekt nötig sind.']
        ].map(([number, title, text]) => <li class="flex gap-5 rounded-2xl bg-white p-6 shadow-sm"><span class="text-2xl font-bold text-teal-600">{number}</span><div><h3 class="font-bold text-slate-900">{title}</h3><p class="mt-2 text-sm leading-relaxed text-slate-600">{text}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="container mx-auto max-w-7xl px-4"><div class="grid gap-6 md:grid-cols-3"><div class="rounded-2xl border border-slate-200 p-6"><h2 class="text-xl font-bold text-slate-900">Baurecht</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">In Köln und NRW können Nutzungsänderung, Dachaufbauten, Gestaltung, Denkmalschutz und Bebauungsplan entscheidend sein.</p><a class="mt-4 inline-block text-sm font-semibold text-teal-700" href="/ratgeber/baugenehmigung-dachgeschoss-koeln/">Baugenehmigung verstehen →</a></div><div class="rounded-2xl border border-slate-200 p-6"><h2 class="text-xl font-bold text-slate-900">Bauphysik</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">Dämmung, Luftdichtheit, Wärmebrücken, sommerlicher Wärmeschutz und Schallschutz gehören in dieselbe Planung.</p><a class="mt-4 inline-block text-sm font-semibold text-teal-700" href="/leistungen/daemmung/">Dämmung ansehen →</a></div><div class="rounded-2xl border border-slate-200 p-6"><h2 class="text-xl font-bold text-slate-900">Kosten</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">Richtwerte sind nur sinnvoll, wenn ihr Umfang klar ist. Wir zeigen, welche Kostentreiber zuerst geklärt werden sollten.</p><a class="mt-4 inline-block text-sm font-semibold text-teal-700" href="/ratgeber/kosten-dachgeschossausbau-pro-qm/">Kostenfaktoren lesen →</a></div></div></div>
    </section>

    <section class="bg-slate-50 py-14 md:py-20"><div class="container mx-auto max-w-4xl px-4"><p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Fragen vor dem Start</p><h2 class="mt-3 text-3xl font-bold text-slate-900">Dachgeschossausbau kurz erklärt</h2><div class="mt-8"><FAQ faqs={faqs} /></div></div></section>

    <section class="bg-white py-14 md:py-20"><div class="container mx-auto max-w-7xl px-4"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Ratgeber</p><h2 class="mt-3 text-3xl font-bold text-slate-900">Vorbereitung, Kosten und Genehmigung</h2></div><a class="font-semibold text-teal-700" href="/ratgeber/">Alle Ratgeber →</a></div><div class="mt-8 grid gap-5 md:grid-cols-3">{guides.slice(0, 3).map(guide => <a href={`/ratgeber/${guide.slug}/`} class="rounded-2xl border border-slate-200 p-6 transition hover:border-teal-400 hover:bg-teal-50"><h3 class="text-lg font-bold text-slate-900">{guide.title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{guide.description}</p></a>)}</div></div></section>

    <LeadForm variant="full" formId="lead-home-bottom" title="Dachgeschossprojekt in Köln besprechen" subtitle="Senden Sie die Eckdaten Ihres Vorhabens. Unvollständige Unterlagen sind in Ordnung." buttonText="Unverbindlich anfragen" />
  </main>
  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
