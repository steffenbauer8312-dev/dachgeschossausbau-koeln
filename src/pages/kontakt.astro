---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout title="Kontakt | Dachgeschossausbau Köln" description="Dachgeschossausbau in Köln anfragen: Kontaktdaten und Formular für erste Eckdaten zu Ihrem Vorhaben.">
  <Header />
  <main>
    <section class="bg-slate-900 text-white"><div class="container mx-auto max-w-4xl px-4 py-14 md:py-20"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Kontakt</p><h1 class="mt-4 text-4xl font-bold md:text-5xl">Dachgeschossprojekt in Köln anfragen</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Beschreiben Sie kurz Bestand und Ziel. Fotos, Pläne und unvollständige Angaben können später ergänzt werden.</p></div></section>
    <section class="bg-white py-14 md:py-20"><div class="container mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-[.75fr_1.25fr] lg:items-start"><div><h2 class="text-2xl font-bold text-slate-900">Direkter Kontakt</h2><p class="mt-4 leading-relaxed text-slate-600">Dachgeschossausbau Köln<br />Hauptstr. 134<br />51143 Köln</p><p class="mt-5 leading-relaxed text-slate-600"><a class="text-teal-700 underline" href="tel:+4915216117439">+49 152 16117439</a><br /><a class="text-teal-700 underline" href="mailto:info@dachgeschossausbau-koeln.de">info@dachgeschossausbau-koeln.de</a></p><p class="mt-6 text-sm leading-relaxed text-slate-500">Für eine fachliche Einordnung sind Angaben zu Dachform, Baujahr, gewünschter Nutzung und bekannten Schäden besonders hilfreich.</p></div><LeadForm variant="full" formId="lead-contact" title="Anfrage senden" subtitle="Die Pflichtfelder reichen für den ersten Kontakt." buttonText="Anfrage senden" /></div></section>
  </main>
  <Footer />
</BaseLayout>
