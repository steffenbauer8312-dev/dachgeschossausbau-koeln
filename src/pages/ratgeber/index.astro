---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import { guides } from '../../data/site';
---

<BaseLayout title="Ratgeber Dachgeschossausbau Köln" description="Ratgeber zu Kosten, Baugenehmigung, Dachaufstockung, Gauben und GEG beim Dachgeschossausbau in Köln.">
  <Header />
  <main>
    <section class="bg-slate-900 text-white"><div class="container mx-auto grid max-w-7xl gap-10 px-4 py-12 md:py-16 lg:grid-cols-[1fr_26rem] lg:items-center"><div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Ratgeber</p><h1 class="mt-4 text-4xl font-bold leading-tight md:text-5xl">Dachgeschossausbau in Köln besser vorbereiten</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Sachliche Orientierung zu Fragen, die vor einer Anfrage oder Planung geklärt werden sollten.</p></div><LeadForm variant="inline" formId="lead-guide-top" title="Frage zum Projekt" subtitle="Wir ordnen das Thema Ihrer Anfrage zu." buttonText="Anfrage senden" /></div></section>
    <section class="bg-white py-14 md:py-20"><div class="container mx-auto grid max-w-7xl gap-5 px-4 md:grid-cols-2 lg:grid-cols-3">{guides.map(guide => <a href={`/ratgeber/${guide.slug}/`} class="rounded-2xl border border-slate-200 p-6 transition hover:border-teal-400 hover:bg-teal-50"><h2 class="text-xl font-bold text-slate-900">{guide.title}</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">{guide.description}</p><span class="mt-5 inline-block text-sm font-semibold text-teal-700">Artikel lesen →</span></a>)}</div></section>
    <section class="bg-slate-50 py-14"><div class="container mx-auto max-w-4xl px-4"><h2 class="text-3xl font-bold text-slate-900">Wie die Inhalte genutzt werden sollten</h2><p class="mt-5 leading-relaxed text-slate-600">Die Artikel erklären typische Prüfpunkte und verlinken auf offizielle Stellen. Sie ersetzen weder eine individuelle Planung noch eine Auskunft der Bauaufsicht. Regelungen und Förderprogramme können sich ändern; bei zeitkritischen Entscheidungen zählt der aktuelle Stand der zuständigen Stelle.</p></div></section>
    <LeadForm variant="full" formId="lead-guide-bottom" title="Frage zum Dachgeschossprojekt senden" subtitle="Beschreiben Sie kurz Bestand und Ziel. So lässt sich der passende nächste Schritt auswählen." buttonText="Unverbindlich anfragen" />
  </main>
  <Footer />
</BaseLayout>
