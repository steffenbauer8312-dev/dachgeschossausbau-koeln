---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { services, guides } from '../data/site';

const pages = [
  { label: 'Startseite', href: '/' },
  { label: 'Leistungen', href: '/leistungen/' },
  ...services.map(service => ({ label: service.title, href: `/leistungen/${service.slug}/` })),
  { label: 'Ratgeber', href: '/ratgeber/' },
  ...guides.map(guide => ({ label: guide.title, href: `/ratgeber/${guide.slug}/` })),
  { label: 'Köln und Stadtbezirke', href: '/stadtteile/' },
  { label: 'Kontakt', href: '/kontakt/' },
  { label: 'Impressum', href: '/impressum/' },
  { label: 'Datenschutz', href: '/datenschutz/' }
];
---

<BaseLayout title="Sitemap | Dachgeschossausbau Köln" description="Sitemap der Website Dachgeschossausbau Köln">
  <Header />
  <main class="bg-slate-50 py-16"><div class="container mx-auto max-w-5xl px-4"><h1 class="text-3xl font-bold text-slate-900">Sitemap</h1><p class="mt-3 text-slate-600">Alle indexierbaren Seiten im Überblick.</p><ul class="mt-8 grid gap-3 md:grid-cols-2">{pages.map(page => <li><a class="text-teal-700 underline underline-offset-2" href={page.href}>{page.label}</a></li>)}</ul></div></main>
  <Footer />
</BaseLayout>
