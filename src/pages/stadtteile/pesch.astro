---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet ein DG-Ausbau in Pesch?',
    answer: 'Pesch ist einer der günstigsten Stadtteile Kölns: 1.300 bis 1.700 Euro pro Quadratmeter. Bei den vielen flachen Dächern ist eine vollständige Dachaufstockung oft möglich.'
  },
  {
    question: 'Welche Bausubstanz hat Pesch?',
    answer: 'Pesch ist Teil der großen Chorweiler-Siedlung. Die Geschossbauten aus den 1960er/70er Jahren haben flache Dächer und Kniestöcke zwischen 70 und 100 cm. Bei den Reihenhäusern sind konventionelle Lösungen möglich.'
  },
  {
    question: 'Welche Lösungen sind in Pesch möglich?',
    answer: 'Bei den flachen Dächern in Pesch ist die <a href="/leistungen/dachaufstockung" class="text-teal-600 hover:underline">Dachaufstockung</a> oft die erste Wahl – eine komplette neue Etage auf dem Bestand. Flachdachgauben oder moderne Aufbauten kommen ebenfalls in Frage.'
  },
  {
    question: 'Brauche ich in Pesch eine Baugenehmigung?',
    answer: 'Ja, wie in ganz Köln. In Pesch verläuft die Genehmigung oft unkompliziert, weil es wenig Denkmalschutz gibt. Bei WEG-Projekten stimmen wir die Pläne mit allen Eigentümern ab.'
  },
  {
    question: 'Lohnt sich der DG-Ausbau in Pesch?',
    answer: 'Ja. Pesch gehört zu den Stadtteilen mit dem größten Aufwertungspotenzial. Die niedrigen Ausgangskosten kombiniert mit wachsender Nachfrage machen den DG-Ausbau hier zu einer wirtschaftlich attraktiven Investition.'
  }
];

const nachbarstadtteile = [
  { name: 'Chorweiler', slug: 'chorweiler', beschreibung: 'Angrenzende Großsiedlung' },
  { name: 'Lindweiler', slug: 'lindweiler', beschreibung: 'Dörflich, am Stadtrand' },
  { name: 'Seeberg', slug: 'seeberg', beschreibung: 'Ebenfalls Teil der Siedlung' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Pesch, Köln",
  "containedInPlace": { "@type": "City", "name": "Köln" }
};
---

<BaseLayout
  title="Dachgeschossausbau in Pesch (Köln) | Aufwertung mit Potenzial"
  description="Dachgeschossausbau in Köln-Pesch: Aufwertung mit großem Potenzial. Kostenlose Beratung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/stadtteile" class="hover:text-teal-400">Stadtteile</a> /
              <span class="text-white">Pesch</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Dachgeschossausbau in Pesch
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Pesch gehört zu den aufstrebenden Stadtteilen Kölns. Die niedrigen Ausgangskosten und die wachsende Nachfrage machen den DG-Ausbau hier zu einer wirtschaftlich besonders attraktiven Investition.
            </p>
          </div>
          <LeadForm variant="inline" title="Beratung in Pesch" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
            Dachgeschossausbau in Pesch: Aufwertung mit Potenzial
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Pesch ist Teil der großen Chorweiler-Siedlung und gehört zu den aufstrebenden Stadtteilen im Kölner Norden. Die niedrigen Grundstückspreise kombiniert mit wachsender Nachfrage nach Wohnraum machen Pesch zu einem attraktiven Investitionsstandort für den Dachgeschossausbau.
            </p>
            <p>
              Viele Gebäude in Pesch haben flache Dächer, die bisher kaum für Wohnzwecke genutzt wurden. Hier ist eine vollständige <a href="/leistungen/dachaufstockung" class="text-teal-600 hover:underline">Dachaufstockung</a> oft möglich – eine komplette neue Etage auf dem Bestandsdach schafft erheblichen Mehrwert. Bei WEG-Projekten koordinieren wir die Abstimmung zwischen den Eigentümern.
            </p>
            <p>
              Wir betreuen in Pesch sowohl einzelne Eigentümer als auch ganze Wohnungseigentümergemeinschaften. Die Erfahrung zeigt: Projekte in Pesch rechnen sich oft schon nach 8 bis 12 Jahren. Eine kostenlose Erstberatung gibt Ihnen Klarheit über Ihr Potenzial.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Fragen zum Dachgeschossausbau in Pesch
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Angrenzende Stadtteile
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {nachbarstadtteile.map(st => (
              <a href={`/stadtteile/${st.slug}`} class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-slate-800 mb-1">{st.name}</h3>
                <p class="text-slate-600 text-sm">{st.beschreibung}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachgeschossausbau in Pesch anfragen" subtitle="Wir melden uns innerhalb von 24 Stunden." buttonText="Kostenlose Beratung" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
