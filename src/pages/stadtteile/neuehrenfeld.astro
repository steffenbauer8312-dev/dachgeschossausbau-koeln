---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet ein DG-Ausbau in Neuehrenfeld?',
    answer: 'Neuehrenfeld liegt im Mittelfeld: 1.700 bis 2.300 Euro pro Quadratmeter. Die Sanierungswelle, die das Viertel gerade erlebt, treibt die Preise nach oben – eine gute Zeit, um in einen DG-Ausbau zu investieren.'
  },
  {
    question: 'Welche Bausubstanz prägt Neuehrenfeld?',
    answer: 'Neuehrenfeld hat eine Mischung aus Gründerzeitbauten, Nachkriegsbauten und sanierten Altbauten. Die Kniestöcke variieren zwischen 70 und 110 cm. Die Sanierungswelle der letzten Jahre zeigt: Hier wird viel investiert.'
  },
  {
    question: 'Welche Gauben passen in Neuehrenfeld?',
    answer: 'Trapezgauben sind in Neuehrenfeld Standard. Bei denkmalgeschützten Gebäuden oder in Ensembleschutz-Bereichen kommen Sattelgauben in Frage. Bei Sanierungen werden oft großzügige Gauben dimensioniert.'
  },
  {
    question: 'Wie ist die Nachfrage in Neuehrenfeld?',
    answer: 'Neuehrenfeld ist beliebt – die Nähe zu Ehrenfeld und die gute Verkehrsanbindung sorgen für stabile Nachfrage. Ein ausgebautes Dachgeschoss lässt sich hier sehr gut vermieten oder verkaufen.'
  },
  {
    question: 'Lohnt sich der DG-Ausbau in Neuehrenfeld?',
    answer: 'Sehr. Das Viertel entwickelt sich positiv – die Wertsteigerung pro Quadratmeter ist überdurchschnittlich. Wir empfehlen Neuehrenfeld als Investitionsstandort für Eigentümer, die langfristig denken.'
  }
];

const nachbarstadtteile = [
  { name: 'Ehrenfeld', slug: 'ehrenfeld', beschreibung: 'Das bekannte Nachbar-Veedel' },
  { name: 'Bickendorf', slug: 'bickendorf', beschreibung: 'Angrenzend, beliebtes Wohnviertel' },
  { name: 'Vogelsang', slug: 'vogelsang', beschreibung: 'Ruhige Wohnlage, ähnlich im Wandel' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Neuehrenfeld, Köln",
  "containedInPlace": { "@type": "City", "name": "Köln" }
};
---

<BaseLayout
  title="Dachgeschossausbau in Neuehrenfeld (Köln) | Veedel im Wandel"
  description="Dachgeschossausbau in Köln-Neuehrenfeld: Investition in ein aufstrebendes Veedel. Kostenlose Beratung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/stadtteile" class="hover:text-teal-400">Stadtteile</a> /
              <span class="text-white">Neuehrenfeld</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Dachgeschossausbau in Neuehrenfeld
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Neuehrenfeld ist eines der spannendsten Veedel Kölns – im Wandel, mit viel Sanierungspotenzial und einer wachsenden Nachfrage nach Wohnraum. Wir bauen Dachgeschosse in Neuehrenfeld auf dem Stand der Zeit.
            </p>
          </div>
          <LeadForm variant="inline" title="Beratung in Neuehrenfeld" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
            Dachgeschossausbau in Neuehrenfeld: Potenzial nutzen
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Neuehrenfeld durchläuft gerade eine spannende Transformation. Aus dem einstigen Arbeiter- und Pendlerviertel wird ein lebendiges Wohnquartier mit steigender Nachfrage. Wer hier in einen Dachgeschossausbau investiert, profitiert von dieser Dynamik – die Wertsteigerung pro Quadratmeter ist überdurchschnittlich.
            </p>
            <p>
              Die Bausubstanz in Neuehrenfeld ist vielfältig: Gründerzeitbauten, Nachkriegsbauten und bereits sanierte Altbauten. Diese Mischung erfordert individuelle Lösungen. Wir setzen in Neuehrenfeld auf moderne Gaubenlösungen mit großzügigen Dimensionen – passend zum Charakter eines Veedels im Aufbruch.
            </p>
            <p>
              Die Sanierungswelle in Neuehrenfeld zeigt: Hier wird investiert. Eine <a href="/leistungen/daemmung" class="text-teal-600 hover:underline">energetische Sanierung</a> kombiniert mit einem DG-Ausbau bringt langfristig niedrige Heizkosten und hohen Wohnkomfort. Wir beraten Sie zu den passenden <a href="/foerderrechner" class="text-teal-600 hover:underline">Förderprogrammen</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Fragen zum Dachgeschossausbau in Neuehrenfeld
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Angrenzende Stadtteile
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {nachbarstadtteile.map(st => (
              <a href={`/stadtteile/${st.slug}`} class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-slate-800 mb-1">{st.name}</h3>
                <p class="text-slate-600 text-sm">{st.beschreibung}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachgeschossausbau in Neuehrenfeld anfragen" subtitle="Wir melden uns innerhalb von 24 Stunden." buttonText="Kostenlose Beratung" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
