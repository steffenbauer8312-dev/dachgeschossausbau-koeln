---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet ein DG-Ausbau in Chorweiler?',
    answer: 'Chorweiler ist einer der günstigsten Stadtteile Kölns: 1.200 bis 1.700 Euro pro Quadratmeter. Bei den vielen flachen Dächern in den Großsiedlungen lohnt sich oft eine vollständige Dachaufstockung.'
  },
  {
    question: 'Welche Bausubstanz hat Chorweiler?',
    answer: 'Chorweiler ist eine Großsiedlung aus den 1960er/70er Jahren mit viel Geschosswohnungsbau. Die Dächer sind oft flach und wurden bisher kaum für Wohnzwecke genutzt – enormes Potenzial für Dachaufstockungen.'
  },
  {
    question: 'Welche Lösungen sind in Chorweiler möglich?',
    answer: 'Bei den flachen Dächern in Chorweiler ist die <a href="/leistungen/dachaufstockung" class="text-teal-600 hover:underline">Dachaufstockung</a> oft die beste Lösung – eine komplette neue Etage auf dem Bestandsdach. Flachdachgauben oder moderne Aufbauten kommen ebenfalls in Frage.'
  },
  {
    question: 'Brauche ich in Chorweiler eine Baugenehmigung?',
    answer: 'Ja. In Chorweiler verläuft die Genehmigung oft unkompliziert, weil es wenig Denkmalschutz gibt. Bei Großsiedlungen ist die Abstimmung mit der WEG (Wohnungseigentümergemeinschaft) wichtig – das übernehmen wir für Sie.'
  },
  {
    question: 'Lohnt sich der DG-Ausbau in Chorweiler?',
    answer: 'Ja. Die niedrigen Grundstückspreise in Kombination mit großer Nachfrage nach familiengerechtem Wohnraum machen den DG-Ausbau in Chorweiler wirtschaftlich attraktiv. Wir betreuen auch WEG-Projekte mit mehreren Parteien.'
  }
];

const nachbarstadtteile = [
  { name: 'Pesch', slug: 'pesch', beschreibung: 'Teil der Chorweiler Siedlung' },
  { name: 'Lindweiler', slug: 'lindweiler', beschreibung: 'Dörflicher Charakter am Stadtrand' },
  { name: 'Seeberg', slug: 'seeberg', beschreibung: 'Angrenzend, ähnliche Siedlungsstruktur' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Chorweiler, Köln",
  "containedInPlace": { "@type": "City", "name": "Köln" }
};
---

<BaseLayout
  title="Dachgeschossausbau in Chorweiler (Köln) | Dachaufstockung"
  description="Dachgeschossausbau in Köln-Chorweiler: Großes Potenzial durch flache Dächer. Dachaufstockung im günstigsten Stadtteil Kölns. Beratung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/stadtteile" class="hover:text-teal-400">Stadtteile</a> /
              <span class="text-white">Chorweiler</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Dachgeschossausbau in Chorweiler
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Chorweiler hat enormes Potenzial: Die flachen Dächer der Großsiedlung bieten sich für vollständige Dachaufstockungen an. Wir betreuen in Chorweiler auch WEG-Projekte mit mehreren Parteien.
            </p>
          </div>
          <LeadForm variant="inline" title="Beratung in Chorweiler" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
            Dachgeschossausbau in Chorweiler: Potenzial der Großsiedlung
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Chorweiler ist eine der großen Neubausiedlungen Kölns aus den 1960er und 1970er Jahren. Die weitläufigen Geschossbauten haben überwiegend flache Dächer, die bisher kaum für Wohnzwecke genutzt wurden. Das bietet enormes Potenzial für <a href="/leistungen/dachaufstockung" class="text-teal-600 hover:underline">Dachaufstockungen</a> – komplette neue Etagen, die das Stadtbild und die Wohnsituation gleichermaßen verbessern.
            </p>
            <p>
              Wir betreuen in Chorweiler sowohl einzelne Eigentümer als auch ganze Wohnungseigentümergemeinschaften (WEGs). Bei WEG-Projekten koordinieren wir die Abstimmung zwischen den Parteien, kümmern uns um die Baugenehmigung und sorgen für eine reibungslose Bauausführung.
            </p>
            <p>
              Die niedrigen Grundstückspreise in Chorweiler machen den DG-Ausbau besonders wirtschaftlich. Eine zusätzliche Wohneinheit im Dach steigert den Wert einer Immobilie oft um 15 bis 25 Prozent – bei den niedrigen Ausgangskosten ein attraktiver Hebel. Wir zeigen Ihnen in einer kostenlosen Erstberatung, was möglich ist.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Fragen zum Dachgeschossausbau in Chorweiler
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Stadtteile rund um Chorweiler
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {nachbarstadtteile.map(st => (
              <a href={`/stadtteile/${st.slug}`} class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-slate-800 mb-1">{st.name}</h3>
                <p class="text-slate-600 text-sm">{st.beschreibung}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachgeschossausbau in Chorweiler anfragen" subtitle="Wir melden uns innerhalb von 24 Stunden." buttonText="Kostenlose Beratung" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
