---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet ein DG-Ausbau in Marienburg?',
    answer: 'Marienburg gehört zu den teuersten Wohnlagen Kölns: 2.200 bis 3.000 Euro pro Quadratmeter. Die Investition lohnt sich – die Wertsteigerung durch einen hochwertigen Dachgeschossausbau ist in Marienburg besonders hoch.'
  },
  {
    question: 'Welche Häuser stehen in Marienburg?',
    answer: 'Großvillen, Doppelhaushälften und gehobene Einfamilienhäuser auf großzügigen Grundstücken. Die Kniestöcke sind mit 120 bis 180 cm oft optimal. Hier lassen sich sehr großzügige Dachgeschosse realisieren.'
  },
  {
    question: 'Welche Gauben passen in Marienburg?',
    answer: 'In Marienburg sind architektonisch anspruchsvolle Lösungen möglich: großflächige Trapezgauben, Sattelgauben mit Loggia, Balkone oder gar Dachterrassen. Wir stimmen die Lösung auf den Stil Ihrer Villa ab.'
  },
  {
    question: 'Wie ist die Denkmalschutz-Lage in Marienburg?',
    answer: 'Marienburg hat viele denkmalgeschützte Villen – vor allem entlang der Bayenthaler Straße und am Rhein. Hier ist eine enge Abstimmung mit dem Denkmalschutz nötig. Wir haben Erfahrung mit den Auflagen und finden auch für denkmalgeschützte Häuser moderne, genehmigungsfähige Lösungen.'
  },
  {
    question: 'Welche Ausstattung erwarten Käufer in Marienburg?',
    answer: 'In Marienburg erwarten Käufer gehobene Ausstattung: hochwertige Materialien, edle Bäder, ggf. Aufzug, Smart-Home-Technik. Wir setzen Ihre individuellen Wünsche um und arbeiten mit erfahrenen Innenarchitekten zusammen.'
  }
];

const nachbarstadtteile = [
  { name: 'Rodenkirchen', slug: 'rodenkirchen', beschreibung: 'Rheinnah, ähnlich gehobene Wohnlage' },
  { name: 'Bayenthal', slug: 'bayenthal', beschreibung: 'Angrenzend, ebenfalls Villenstruktur' },
  { name: 'Lindenthal', slug: 'lindenthal', beschreibung: 'Villenviertel am Grüngürtel' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Marienburg, Köln",
  "containedInPlace": { "@type": "City", "name": "Köln" }
};
---

<BaseLayout
  title="Dachgeschossausbau in Marienburg (Köln) | Premium Villen"
  description="Dachgeschossausbau in Köln-Marienburg: Hochwertige Lösungen für Villen in bester Wohnlage. Individuelle Architektur, Denkmalschutz-Erfahrung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/stadtteile" class="hover:text-teal-400">Stadtteile</a> /
              <span class="text-white">Marienburg</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Dachgeschossausbau in Marienburg
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Marienburg ist Kölns Premium-Wohnlage. Wir realisieren Dachgeschossausbauten auf dem Niveau, das zu diesem Veedel passt – mit Architektur, Statik und Ausstattung auf höchstem Niveau.
            </p>
          </div>
          <LeadForm variant="inline" title="Beratung in Marienburg" subtitle="Diskret und individuell." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
            Dachgeschossausbau in Marienburg: Premium-Lösungen
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Marienburg gehört zu den Top-Wohnlagen Deutschlands. Großzügige Villen auf weitläufigen Grundstücken, durchschnittliche Kniestöcke von 120 bis 180 cm, und häufig die Möglichkeit, eine vollständige <a href="/leistungen/dachaufstockung" class="text-teal-600 hover:underline">Dachaufstockung</a> zu realisieren. Hier ist der Dachgeschossausbau eine Investition in bleibende Werte.
            </p>
            <p>
              Viele Marienburger Villen stehen unter Denkmalschutz – vor allem entlang der Bayenthaler Straße und in Rheinnähe. Wir haben in den letzten Jahren mehrere denkmalgeschützte Objekte in Marienburg erfolgreich ausgebaut und kennen die Auflagen genau. Wo andere aufgeben, finden wir Lösungen.
            </p>
            <p>
              Die Ausstattung in Marienburg ist gehoben: edle Materialien, hochwertige Bäder, ggf. Aufzug, Smart-Home. Wir arbeiten mit erfahrenen Innenarchitekten und kümmern uns um jedes Detail. Eine kostenlose Erstberatung bei Ihnen vor Ort gibt Ihnen Klarheit über die Möglichkeiten.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Fragen zum Dachgeschossausbau in Marienburg
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Stadtteile rund um Marienburg
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {nachbarstadtteile.map(st => (
              <a href={`/stadtteile/${st.slug}`} class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-slate-800 mb-1">{st.name}</h3>
                <p class="text-slate-600 text-sm">{st.beschreibung}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachgeschossausbau in Marienburg anfragen" subtitle="Wir melden uns innerhalb von 24 Stunden." buttonText="Kostenlose Beratung" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
