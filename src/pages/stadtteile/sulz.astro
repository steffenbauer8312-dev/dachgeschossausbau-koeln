---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet ein DG-Ausbau in Sülz?',
    answer: 'In Sülz liegen die Kosten zwischen 1.700 und 2.300 Euro pro Quadratmeter. Die Bandbreite ist groß, weil die Bausubstanz von Gründerzeit bis Nachkriegsbau reicht. Wir beraten Sie kostenlos zu Ihrem konkreten Projekt.'
  },
  {
    question: 'Welche Bausubstanz hat Sülz?',
    answer: 'Sülz hat eine sehr gemischte Bausubstanz: Gründerzeitbauten mit hohen Kniestöcken, Nachkriegsbauten mit flacheren Dächern und neuere Eigentumswohnungen. Diese Vielfalt erfordert individuelle Lösungen – wir prüfen vorab, was bei Ihrem Haus möglich ist.'
  },
  {
    question: 'Welche Gauben passen in Sülz?',
    answer: 'Trapezgauben sind in Sülz am häufigsten und passen zu den meisten Dächern. Bei Nachkriegsbauten kommen auch Flachdachgauben oder moderne Lösungen in Frage. Wir stimmen die Gaubenform auf Ihr Haus und die Nachbarbebauung ab.'
  },
  {
    question: 'Wie ist die Lage in Sülz für Mietwohnungen?',
    answer: 'Sülz ist wegen der Uni-Nähe sehr gefragt. Ein ausgebautes Dachgeschoss lässt sich hier problemlos vermieten – oft schon während der Bauphase mit Vorvermietung. Die Wertsteigerung pro Quadratmeter ist in Sülz überdurchschnittlich.'
  },
  {
    question: 'Brauche ich in Sülz eine Baugenehmigung?',
    answer: 'Ja, immer. In Sülz gibt es vereinzelt Ensembleschutz, aber die meisten DG-Ausbauten verlaufen genehmigungstechnisch unkompliziert. Wir übernehmen den kompletten Bauantrag.'
  }
];

const nachbarstadtteile = [
  { name: 'Lindenthal', slug: 'lindenthal', beschreibung: 'Gehobene Wohnlage angrenzend' },
  { name: 'Ehrenfeld', slug: 'ehrenfeld', beschreibung: 'Lebendiges Veedel mit viel Nachfrage' },
  { name: 'Klettenberg', slug: 'klettenberg', beschreibung: 'Familienfreundlich, ähnliche Bausubstanz' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Sülz, Köln",
  "containedInPlace": { "@type": "City", "name": "Köln" }
};
---

<BaseLayout
  title="Dachgeschossausbau in Sülz (Köln) | Uni-Nähe & Altbau"
  description="Dachgeschossausbau in Köln-Sülz: Gemischte Bausubstanz vom Gründerzeitbau bis zum Nachkriegsbau. Kostenlose Erstberatung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/stadtteile" class="hover:text-teal-400">Stadtteile</a> /
              <span class="text-white">Sülz</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Dachgeschossausbau in Sülz
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Sülz ist bunt gemischt: Altbau, Nachkriegsbau, Uni-Nähe. Wir bauen Dachgeschosse in Sülz mit der Erfahrung aus vielen Projekten – individuell angepasst an Ihr Haus.
            </p>
          </div>
          <LeadForm variant="inline" title="Beratung in Sülz" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
            Dachgeschossausbau in Sülz – vielfältig wie das Veedel
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Sülz gehört zu den lebendigsten Veedeln Kölns – mit einer sehr gemischten Bausubstanz. Hier finden Sie Gründerzeitbauten mit hohen Kniestöcken neben Nachkriegsbauten mit flacheren Dächern. Diese Vielfalt macht den Dachgeschossausbau in Sülz so spannend: Es gibt fast immer eine Lösung, aber sie ist immer individuell.
            </p>
            <p>
              Uni-Nähe und gute Infrastruktur sorgen in Sülz für eine hohe Nachfrage nach Wohnraum. Ein ausgebautes Dachgeschoss lässt sich hier oft schon vor Fertigstellung vermieten. Wir beraten Sie auch zu Investoren-Modellen und Mehrfamilienhaus-Lösungen.
            </p>
            <p>
              Statisch sind die Sülzer Dächer sehr unterschiedlich. Bei Gründerzeitbauten prüfen wir die alten Sparren, bei Nachkriegsbauten oft die Gaubenanschlüsse. Eine <a href="/leistungen/statik" class="text-teal-600 hover:underline">statische Bestandsaufnahme</a> ist immer sinnvoll – wir zeigen Ihnen, was geht.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Fragen zum Dachgeschossausbau in Sülz
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Stadtteile in der Nähe von Sülz
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {nachbarstadtteile.map(st => (
              <a href={`/stadtteile/${st.slug}`} class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-slate-800 mb-1">{st.name}</h3>
                <p class="text-slate-600 text-sm">{st.beschreibung}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachgeschossausbau in Sülz anfragen" subtitle="Wir melden uns innerhalb von 24 Stunden." buttonText="Kostenlose Beratung" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
