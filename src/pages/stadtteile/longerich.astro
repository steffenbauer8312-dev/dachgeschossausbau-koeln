---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet ein DG-Ausbau in Longerich?',
    answer: 'Longerich ist preislich attraktiv: 1.400 bis 1.900 Euro pro Quadratmeter. Die niedrigeren Ausgangskosten kombiniert mit der stabilen Nachfrage machen den DG-Ausbau hier zu einer soliden Investition.'
  },
  {
    question: 'Welche Bausubstanz hat Longerich?',
    answer: 'Longerich hat Reihenhäuser, Einfamilienhäuser und villenartige Strukturen. Die Kniestöcke liegen zwischen 80 und 110 cm – gute Voraussetzungen für den DG-Ausbau.'
  },
  {
    question: 'Welche Gauben passen in Longerich?',
    answer: 'Kleine bis mittlere Sattelgauben sind in Longerich üblich. Sie passen zum ländlichen Charakter des Viertels und fügen sich harmonisch in die Nachbarbebauung ein.'
  },
  {
    question: 'Wie ist die Lage in Longerich?',
    answer: 'Longerich hat ländlichen Charakter trotz Stadtlage. Die Nähe zum Fühlinger See und die gute Infrastruktur machen das Viertel für Familien attraktiv.'
  },
  {
    question: 'Lohnt sich der DG-Ausbau in Longerich?',
    answer: 'Ja. Die stabile Wertentwicklung und die moderate Preisentwicklung machen Longerich zu einem soliden Investitionsstandort. Eine zusätzliche Wohneinheit im Dach steigert den Wert deutlich.'
  }
];

const nachbarstadtteile = [
  { name: 'Nippes', slug: 'nippes', beschreibung: 'Dörflich, urban' },
  { name: 'Ossendorf', slug: 'ossendorf', beschreibung: 'Eigenheim-Charakter' },
  { name: 'Fühlingen', slug: 'fuehlingen', beschreibung: 'Ländlich, am See' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Longerich, Köln",
  "containedInPlace": { "@type": "City", "name": "Köln" }
};
---

<BaseLayout
  title="Dachgeschossausbau in Longerich (Köln) | Ländlich & Stabil"
  description="Dachgeschossausbau in Köln-Longerich: Solide Investition im ländlichen Charakter des Viertels. Kostenlose Beratung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/stadtteile" class="hover:text-teal-400">Stadtteile</a> /
              <span class="text-white">Longerich</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Dachgeschossausbau in Longerich
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Longerich ist ländlich geprägt und familienfreundlich. Wir bauen Dachgeschosse in Longerich, die zum Charakter des Viertels passen – solide, mit Sattelgauben, wertstabil.
            </p>
          </div>
          <LeadForm variant="inline" title="Beratung in Longerich" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">
            Dachgeschossausbau in Longerich: ländlicher Charakter
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Longerich hat trotz seiner Lage im Kölner Norden einen ausgeprägten ländlichen Charakter. Die vielen Reihenhäuser und Einfamilienhäuser sind eingebettet in eine gewachsene Nachbarschaft mit guter Infrastruktur und viel Grün. Hier passt ein DG-Ausbau, der sich am Bestand orientiert.
            </p>
            <p>
              Wir setzen in Longerich auf <a href="/leistungen/gauben" class="text-teal-600 hover:underline">Sattelgauben</a>, die zum dörflichen Charakter des Viertels passen. Die mittleren Kniestöcke (80-110 cm) lassen sich mit einer gut geplanten Gaube zu vollwertigem Wohnraum machen. Bei Bedarf kombinieren wir den Ausbau mit einer energetischen <a href="/leistungen/daemmung" class="text-teal-600 hover:underline">Sanierung</a>.
            </p>
            <p>
              Die Wertentwicklung in Longerich ist stabil. Eine zusätzliche Wohneinheit im Dach steigert den Wert einer Immobilie typischerweise um 12 bis 18 Prozent. Viele Eigentümer nutzen den DG-Ausbau, um Familienwohnraum zu schaffen oder durch Vermietung eine Rendite zu erwirtschaften.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Fragen zum Dachgeschossausbau in Longerich
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">
            Angrenzende Stadtteile
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {nachbarstadtteile.map(st => (
              <a href={`/stadtteile/${st.slug}`} class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-slate-800 mb-1">{st.name}</h3>
                <p class="text-slate-600 text-sm">{st.beschreibung}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachgeschossausbau in Longerich anfragen" subtitle="Wir melden uns innerhalb von 24 Stunden." buttonText="Kostenlose Beratung" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
