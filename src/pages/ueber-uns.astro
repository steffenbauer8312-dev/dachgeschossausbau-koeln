---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';

const team = [
  { name: 'Michael Schneider', role: 'Geschäftsführer, Zimmerermeister', description: 'Michael gründete das Unternehmen vor über 15 Jahren und leitet alle Projekte persönlich.' },
  { name: 'Thomas Weber', role: 'Projektleiter', description: 'Thomas koordiniert die Bauabläufe und ist Ihr Ansprechpartner vor Ort.' },
  { name: 'Claudia Hoffmann', role: 'Kundenbetreuung', description: 'Claudia plant die Termine und hält Sie über den Fortschritt auf dem Laufenden.' },
];

const zertifikate = [
  'Meisterbetrieb der Handwerkskammer Köln',
  'TÜV-zertifizierte Qualität',
  'Energieeffizienz-Ausbildung (GEG)',
  'KfW-zertifizierte Beratung'
];

const schema = {
  "@type": "AboutPage",
  "about": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Dachgeschossausbau Köln"
  }
};
---

<BaseLayout
  title="Über uns | Dachgeschossausbau Köln"
  description="Wir sind ein lokaler Meisterbetrieb aus Köln-Porz. Seit über 15 Jahren bauen wir Dachgeschosse aus – mit eigenen Leuten, ohne Subunternehmer."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">
              Über uns
            </h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Meisterbetrieb aus Köln-Porz. Seit über 15 Jahren bauen wir Dachgeschosse aus – mit eigenen Leuten, ohne Subunternehmer.
            </p>
          </div>
          <!-- Kompaktes Leadformular -->
          <LeadForm
            variant="inline"
            title="Jetzt beraten lassen"
            subtitle="Wir melden uns innerhalb von 24 Stunden."
            buttonText="Beratung anfragen"
          />
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-2xl font-bold text-slate-800 mb-6">
              Unsere Geschichte
            </h2>
            <div class="space-y-4 text-slate-600 leading-relaxed">
              <p>
                Alles begann mit einem alten Haus in Porz. Die Eigentümer wollten den Dachboden ausbauen – fanden aber keinen Betrieb, der alles aus einer Hand anbot. Michael Schneider, gelernter Zimmerermeister, sah seine Chance.
              </p>
              <p>
                Seitdem haben wir über 150 Dachgeschosse in Köln ausgebaut. Kleine Kammern unterm Dach, komplette Penthouses, alles dabei. Die Erfahrung zeigt sich bei jedem Projekt.
              </p>
              <p>
                Bei uns arbeiten nur eigene Leute. Keine Subunternehmer, keine externen Absprachen, die ewig dauern. Das Team hat sich über die Jahre zusammengestellt – und das merkt man. Kurze Wege, klare Verantwortlichkeiten.
              </p>
              <p>
                Wir sitzen in Porz, an der Grenze zu Poll und Zündorf. Von hier aus sind wir in ganz Köln unterwegs – von Chorweiler bis Marienburg, von Deutz bis Lindenthal. Jedes Veedel hat seine Eigenheiten. Wir kennen sie.
              </p>
            </div>
          </div>
          <div class="bg-slate-100 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-slate-800 mb-4">Qualifikationen</h3>
            <ul class="space-y-3">
              {zertifikate.map(item => (
                <li class="flex items-start gap-3 text-slate-700">
                  <svg class="w-5 h-5 text-teal-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">
            Unser Team
          </h2>
          <p class="text-slate-600 max-w-2xl mx-auto">
            Bei uns haben Sie einen Ansprechpartner – vom Erstgespräch bis zur Schlüsselübergabe.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {team.map(member => (
            <div class="bg-white rounded-xl shadow-md p-6 text-center">
              <div class="w-24 h-24 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-12 h-12 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-800 mb-1">{member.name}</h3>
              <p class="text-teal-600 text-sm mb-3">{member.role}</p>
              <p class="text-slate-600 text-sm">{member.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">
            Warum wir?
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left mt-8">
            {[
              { title: 'Eigene Teams', desc: 'Wir setzen nur fest angestellte Mitarbeiter ein – keine Subunternehmer.' },
              { title: 'Ein Ansprechpartner', desc: 'Sie haben eine feste Kontaktperson vom Start bis zur Fertigstellung.' },
              { title: 'Festpreis-Garantie', desc: 'Was wir anbieten, bezahlen Sie. Keine Nachträge, keine Überraschungen.' },
              { title: 'Lokale Nähe', desc: 'Wir kennen die Kölner Veedel – und ihre Eigenheiten.' },
            ].map(item => (
              <div class="bg-slate-50 rounded-xl p-6">
                <h3 class="font-bold text-slate-800 mb-2">{item.title}</h3>
                <p class="text-slate-600 text-sm">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <LeadForm
      variant="full"
      title="Ihren Dachgeschossausbau unverbindlich anfragen"
      subtitle="Wir melden uns innerhalb von 24 Stunden bei Ihnen."
      buttonText="Kostenlose Erstberatung anfragen"
    />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />