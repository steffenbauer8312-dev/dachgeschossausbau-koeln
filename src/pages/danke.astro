---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Anfrage erhalten | Dachgeschossausbau Köln" description="Ihre Anfrage zum Dachgeschossausbau wurde übermittelt.">
  <Header />
  <main class="bg-slate-50 py-20 md:py-28"><div class="container mx-auto max-w-2xl px-4 text-center"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Vielen Dank</p><h1 class="mt-4 text-4xl font-bold text-slate-900">Ihre Anfrage wurde übermittelt</h1><p class="mt-5 leading-relaxed text-slate-600">Die Angaben werden nun geprüft. Falls für die Einordnung Unterlagen fehlen, können diese im weiteren Kontakt ergänzt werden.</p><a class="mt-8 inline-flex rounded-lg bg-teal-600 px-5 py-3 font-semibold text-white hover:bg-teal-700" href="/">Zur Startseite</a></div></main>
  <Footer />
</BaseLayout>
