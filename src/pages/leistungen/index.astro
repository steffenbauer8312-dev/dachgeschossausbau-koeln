---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import { services } from '../../data/site';
---

<BaseLayout title="Leistungen für Dachausbau in Köln" description="Dachgeschossausbau, Dachaufstockung, Gauben, Dachdämmung, Dachfenster, Dachterrasse, Statik und Innenausbau in Köln.">
  <Header />
  <main>
    <section class="bg-slate-900 text-white"><div class="container mx-auto grid max-w-7xl gap-10 px-4 py-12 md:py-16 lg:grid-cols-[1fr_26rem] lg:items-center"><div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Leistungen</p><h1 class="mt-4 text-4xl font-bold leading-tight md:text-5xl">Dachausbau in Köln nach Vorhaben sortiert</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Jede Leistungsseite beantwortet eine eigene Frage. So finden Sie schneller heraus, welche Prüfung und welcher nächste Schritt zu Ihrem Gebäude passt.</p></div><LeadForm variant="inline" formId="lead-services-top" title="Vorhaben auswählen" subtitle="Wir ordnen die Anfrage dem passenden Thema zu." buttonText="Anfrage senden" /></div></section>
    <section class="bg-white py-14 md:py-20"><div class="container mx-auto max-w-7xl px-4"><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{services.map(service => <a href={`/leistungen/${service.slug}/`} class="group rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-0.5 hover:border-teal-400 hover:bg-teal-50"><p class="text-sm font-semibold text-teal-700">{service.eyebrow}</p><h2 class="mt-3 text-xl font-bold text-slate-900 group-hover:text-teal-900">{service.title}</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">{service.description}</p><span class="mt-5 inline-block text-sm font-semibold text-teal-700">Leistungsdetails →</span></a>)}</div></div></section>
    <section class="bg-slate-50 py-14"><div class="container mx-auto max-w-4xl px-4"><h2 class="text-3xl font-bold text-slate-900">Warum die Reihenfolge wichtig ist</h2><p class="mt-5 leading-relaxed text-slate-600">Ein Dachfenster kann ohne die richtige Dämm- und Anschlussplanung zum späteren Problem werden. Eine Gaube kann Raum gewinnen, aber auch Statik, Gestaltung und Baurecht berühren. Deshalb verlinken die Leistungsseiten bewusst aufeinander und betrachten die Themen als zusammenhängenden Planungsprozess.</p></div></section>
    <LeadForm variant="full" formId="lead-services-bottom" title="Vorhaben in Köln einordnen" subtitle="Nennen Sie uns den Ausgangspunkt. Die passenden Prüfpunkte lassen sich dann gezielt festlegen." buttonText="Unverbindlich anfragen" />
  </main>
  <Footer />
</BaseLayout>
