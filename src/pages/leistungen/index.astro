const faqs = [
  {
    question: 'Welche Leistungen bieten Sie im Dachgeschossausbau an?',
    answer: 'Wir machen alles aus einer Hand: Statik, Dämmung, Trockenbau, Elektro, Sanitär, Heizung. Dazu kommen Spezialleistungen wie Gaubenbau, Dachstuhlsanierung, Fassadenbau, Carport und Holzgaragen. Insgesamt über 40 Leistungen rund ums Dach in Köln.'
  },
  {
    question: 'Was kostet ein Dachgeschossausbau in Köln?',
    answer: 'Einfache Ausbauten beginnen bei 1.400 Euro pro Quadratmeter, vollständige Wohnungen liegen bei 1.800 bis 2.400 Euro. Dachaufstockungen kosten 2.500 bis 3.500 Euro pro Quadratmeter. Mit BAFA- und KfW-Förderung reduzieren sich die effektiven Kosten um 20 bis 35 Prozent.'
  },
  {
    question: 'Wie lange dauert ein Dachausbau?',
    answer: 'Ein einfacher Ausbau dauert 8 bis 12 Wochen reine Bauzeit. Komplexere Aufstockungen oder Aufstockung plus Dachgeschossausbau 4 bis 6 Monate. Mit Genehmigungsphase rechnen wir insgesamt 4 bis 9 Monate.'
  },
  {
    question: 'Bekomme ich Förderung für den Dachausbau?',
    answer: 'Ja, mehrere Programme: BAFA BEG EM (15 bis 20 Prozent Zuschuss), KfW 261 (günstiger Kredit mit Tilgungszuschuss), Steuerbonus Paragraph 35c EStG (20 Prozent der Handwerkerkosten). Welche Kombination für Sie passt, prüfen wir im Förderrechner.'
  },
  {
    question: 'Welche Stadtteile in Köln betreuen Sie?',
    answer: 'Wir betreuen alle 9 Stadtbezirke und 86 Stadtteile in Köln. Schwerpunkte sind Ehrenfeld, Nippes, Lindenthal, Marienburg, Rodenkirchen, Deutz, Mülheim, Kalk, Porz und alle Innenstadt-Bereiche.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Dachgeschossausbau Köln",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Dachgeschossausbau Köln" }
};
---

<BaseLayout
  title="Leistungen Dachgeschossausbau Köln | Über 40 Angebote aus einer Hand"
  description="Alle Leistungen rund um Dach und Holzbau in Köln: Dachstuhl, Dachausbau, Dämmung, Holzbau, Fassaden, Außenanlagen. Über 40 Leistungen."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">
          Unsere Leistungen in Köln
        </h1>
        <p class="text-xl text-slate-300 max-w-3xl">
          Über 40 Leistungen aus einer Hand. Von der Statik bis zur Fassadensanierung, vom Carport bis zum Fachwerk. Was Sie auf dieser Seite nicht finden, fragen Sie uns direkt, wir machen viel mehr als die aufgelisteten Standardleistungen.
        </p>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto space-y-16">
          {kategorien.map(kat => (
            <div id={kat.slug}>
              <div class="flex items-center gap-4 mb-6">
                <span class="text-4xl">{kat.icon}</span>
                <div>
                  <h2 class="text-2xl md:text-3xl font-bold text-slate-800">{kat.name}</h2>
                  <p class="text-slate-600 mt-1">{kat.description}</p>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {kat.services.map(s => (
                  <a href={`/leistungen/${s.slug}`} class="block bg-slate-50 rounded-xl p-5 hover:bg-teal-50 hover:shadow-md transition-all">
                    <h3 class="text-lg font-bold text-slate-800 mb-1">{s.name}</h3>
                    <p class="text-slate-600 text-sm">{s.desc}</p>
                    <span class="text-teal-600 text-sm font-medium mt-2 inline-block">Mehr erfahren →</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">
            Häufige Fragen zu unseren Leistungen
          </h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <LeadForm
      variant="full"
      title="Welche Leistung brauchen Sie?"
      subtitle="Wir beraten Sie zu allen Gewerken."
      buttonText="Kostenlose Beratung"
    />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
