---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Wann muss ein Sparren ausgetauscht werden?',
    answer: 'Wenn er morsch, gebrochen oder durch Insekten zerfressen ist. Typisch nach Wassereinbruch, Hausschwamm oder Hausbockbefall. Auch statisch überlastete Sparren, die sich dauerhaft verformt haben, kommen für einen Austausch in Frage.'
  },
  {
    question: 'Wann reicht Verstärken statt Tauschen?',
    answer: 'Wenn das Holz noch gesund ist, aber die Tragfähigkeit nicht mehr reicht. Dann setzen wir parallel einen neuen Sparren daneben, schrauben Aufdopplungen auf oder verstärken mit GFK-Profilen. Das ist günstiger als Tausch und beschädigt die Dacheindeckung weniger.'
  },
  {
    question: 'Was kostet der Austausch eines Sparrens?',
    answer: 'Ein einzelner Sparrenwechsel liegt bei 800 bis 1.500 Euro. Bei mehreren Sparren oder aufwendiger Logistik kommen wir auf 3.000 bis 8.000 Euro. Der Preis hängt von Zugänglichkeit, Dacheindeckung und Anschlüssen ab.'
  },
  {
    question: 'Muss das Dach für den Sparrenwechsel geöffnet werden?',
    answer: 'Bei einem Tausch ja, aber nur im Bereich des betroffenen Sparrens. Wir nehmen die Ziegel runter, schneiden den Sparren raus, setzen den neuen ein und decken wieder ein. Bei einer Verstärkung von unten bleibt die Dacheindeckung in der Regel unangetastet.'
  },
  {
    question: 'Welche Holzdimension verwenden Sie?',
    answer: 'Wir verwenden die Sparren, die zur Statik passen. Häufig 8/16 cm oder 8/18 cm, bei größeren Spannweiten auch 10/20 cm oder 12/24 cm. Konstruktionsvollholz (KVH) oder Leimholz (BSH) je nach Anforderung. Die Wahl treffen wir nach den statischen Berechnungen unseres Ingenieurs.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Sparren austauschen oder verstärken",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Dachgeschossausbau Köln" }
};
---

<BaseLayout
  title="Sparren austauschen oder verstärken Köln | Zimmerei"
  description="Sparren tauschen oder verstärken in Köln: einzelne Sparren reparieren, Aufdopplung für mehr Tragfähigkeit. Zimmermeister mit eigener Werkstatt."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/leistungen" class="hover:text-teal-400">Leistungen</a> /
              <span class="text-white">Sparren</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">Sparren austauschen oder verstärken in Köln</h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Ein morscher Sparren ist noch lange kein Grund für ein neues Dach. Wir tauschen einzelne Sparren gezielt aus oder verstärken parallel. Schnell, sauber, mit Statik.
            </p>
          </div>
          <LeadForm variant="inline" title="Sparren prüfen lassen" subtitle="Vor-Ort-Termin in Köln." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">Wann tauschen, wann verstärken?</h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Die Entscheidung treffen wir je nach Schadensbild. Ein morscher oder gebrochener Sparren muss raus, ein gesunder, aber zu schwacher Sparren kann bleiben und bekommt Verstärkung daneben. In Köln sehen wir beides regelmäßig, gerade in Reihenhäusern aus der Gründerzeit.
            </p>
            <p>
              Beim Tausch arbeiten wir abschnittsweise: Dachziegel aufnehmen, Lattung und Unterspannbahn lösen, Sparrenkopf oder -stück herausschneiden, neuen Sparren einsetzen, Anschlüsse herstellen, Unterdach und Eindeckung wiederherstellen. Das dauert pro Sparren ein bis zwei Tage, je nach Zugänglichkeit.
            </p>
            <p>
              Beim Verstärken setzen wir auf eine Sparrenaufdopplung: gleiche Dimension, gleiche Holzqualität, voll verschraubt. Statisch wirkt der Aufdoppel-Sparren wie ein größerer Querschnitt. Bei tragenden Anschlüssen am First oder am Auflager kommen Stahlwinkel, Wechsel oder Bolzen zum Einsatz.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">Typische Einsatzfälle</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { t: 'Sparrenkopf morsch', d: 'Im Auflagerbereich dringt Wasser ein. Wir trennen den Sparren ab und setzen ein neues Stück mit Verstärkungslaschen an.' },
              { t: 'Bruch durch Sturm', d: 'Einzelne Sparren brechen unter Last. Schnelle Sicherung, dann Wechsel des betroffenen Bauteils.' },
              { t: 'Tragfähigkeit reicht nicht', d: 'Beim DG-Ausbau brauchen wir mehr Lastreserve. Aufdopplung, oft ohne Eingriff in die Eindeckung.' },
              { t: 'Schwamm-/Insektenbefall', d: 'Lokal begrenzter Befall wird herausgeschnitten, ein neues Stück eingesetzt, das angrenzende Holz behandelt.' },
              { t: 'Sparren hängt durch', d: 'Verformte Sparren richten wir mit Aufschieblingen, Wechseln oder Verstärkungslaschen wieder gerade.' },
              { t: 'Aufstockung', d: 'Wenn ein Stockwerk draufkommt, werden alle Sparren verstärkt oder durch neue, tragfähigere Hölzer ersetzt.' }
            ].map(i => (
              <div class="bg-white rounded-xl p-5 shadow-sm">
                <h3 class="font-bold text-slate-800 mb-2">{i.t}</h3>
                <p class="text-slate-600 text-sm">{i.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">Fragen zu Sparrenarbeiten</h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">Verwandte Leistungen</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="/leistungen/dachstuhlverstärkung" class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-slate-800 mb-1">Dachstuhlverstärkung</h3>
              <p class="text-slate-600 text-sm">Systematisch Tragfähigkeit erhöhen.</p>
            </a>
            <a href="/leistungen/pfetten-erneuern-verstärken" class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-slate-800 mb-1">Pfetten ertüchtigen</h3>
              <p class="text-slate-600 text-sm">Horizontale Träger instand setzen.</p>
            </a>
            <a href="/leistungen/dachstuhlreparatur" class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-slate-800 mb-1">Reparatur</h3>
              <p class="text-slate-600 text-sm">Punktuelle Hilfe statt Komplettumbau.</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Sparren prüfen lassen" subtitle="Vor-Ort-Termin in Köln." buttonText="Termin anfragen" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
