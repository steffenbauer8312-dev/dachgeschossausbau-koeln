---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was versteht man unter Dachbodenausbau?',
    answer: 'Der Dachboden wird zu Wohnraum umgebaut. Je nach Zustand heißt das: Dämmung nach GEG, Trockenbau, Bodenaufbau, Elektrik, Sanitär, Heizung. Manchmal kommen Gauben oder eine Erhöhung des Kniestocks dazu, damit der Raum nutzbar wird.'
  },
  {
    question: 'Was kostet ein Dachbodenausbau?',
    answer: 'Je nach Ausbauart zwischen 1.400 und 2.500 Euro pro Quadratmeter. Für 60 Quadratmeter rechnen wir mit 84.000 bis 150.000 Euro. Die Wertsteigerung in Köln liegt bei 12 bis 25 Prozent des Immobilienwerts.'
  },
  {
    question: 'Brauche ich für den Dachbodenausbau eine Genehmigung?',
    answer: 'Ja, in Köln ist jeder wohnwirtschaftliche Dachbodenausbau genehmigungspflichtig. Reine Dämmung ohne Wohnnutzung kann in Einzelfällen genehmigungsfrei sein. Wir kümmern uns um den Bauantrag und die Abstimmung mit den Behörden.'
  },
  {
    question: 'Wie lange dauert ein Dachbodenausbau?',
    answer: 'Mit Genehmigung vier bis sechs Monate, davon acht bis zwölf Wochen reine Bauzeit. Bei Bestandshäusern in Ehrenfeld oder Nippes hängen wir oft von der Wetterlage und denkmalschutzrechtlichen Auflagen ab.'
  },
  {
    question: 'Welche Förderung bekomme ich für den Dachbodenausbau?',
    answer: 'Bei energetischer Sanierung greifen BAFA (15 Prozent), KfW 261 und Steuerbonus nach Paragraph 35c. Auch die Stadt Köln hat eigene Zuschüsse. Welche Kombination sinnvoll ist, zeigen wir Ihnen im Förderrechner.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Dachbodenausbau",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Dachgeschossausbau Köln" }
};
---

<BaseLayout
  title="Dachbodenausbau Köln | Wohnraum unterm Dach schaffen"
  description="Dachbodenausbau in Köln: aus ungenutzter Bodenfläche wird vollständiger Wohnraum. Mit Dämmung, Trockenbau, Bad und Heizung."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/leistungen" class="hover:text-teal-400">Leistungen</a> /
              <span class="text-white">Dachbodenausbau</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">Dachbodenausbau in Köln</h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Aus der Abstellfläche unterm Dach wird eine Wohnung mit Bad, Küche und Heizung. Wir machen das in Köln seit Jahren. Festpreis, fester Termin, ein Ansprechpartner für alle Gewerke.
            </p>
          </div>
          <LeadForm variant="inline" title="Dachboden umbauen" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">Dachboden als Wohnraum nutzen</h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Ein unausgebauter Dachboden kostet Heizenergie und bringt keinen Nutzen. Wer dort oben eine vollständige Wohnung schafft, gewinnt 40 bis 80 Quadratmeter und steigert den Wert seines Hauses deutlich. Wir sehen das in Köln in jedem Veedel anders: in Ehrenfeld und Nippes sind es oft Gründerzeitvillen mit knappen Kniestöcken, in Chorweiler und Kalk sind es Flachdächer, die komplett draufgesetzt werden können.
            </p>
            <p>
              Der Ausbau umfasst je nach Zustand: Dämmung nach GEG-Standard, Trockenbau der Schrägen und des Kniestocks, Bodenaufbau mit Trittschalldämmung, Elektroinstallation, Heizungsanschluss, Sanitär, Malerarbeiten, Bodenbeläge. Bei Bedarf kommen Gauben dazu oder die Kniestock-Erhöhung, um Stehhöhe zu schaffen.'
            </p>
            <p>
              Wir setzen auf den vollständigen Ausbau aus einer Hand. Von der Statik über die Dämmung bis zur letzten Schraube. Sie haben einen Ansprechpartner, einen Termin, einen Preis. Das funktioniert in Köln seit Jahren sehr gut, weil unsere Handwerkerteams fest eingespielt sind.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">Was zum Dachbodenausbau gehört</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {[
              'Bestandsaufnahme und Statik', 'Dämmung nach GEG Standard',
              'Trockenbau der Dachschrägen', 'Bodenaufbau mit Trittschall',
              'Elektroinstallation', 'Heizungsanschluss',
              'Sanitärinstallation', 'Maler- und Lackierarbeiten',
              'Bodenbeläge', 'Fenster und Gauben',
              'Treppe und Zugang', 'Schallschutz',
              'Brandschutzmaßnahmen', 'Endreinigung'
            ].map(i => (
              <div class="bg-white rounded-lg p-3 shadow-sm text-slate-700">
                <span class="text-teal-500 mr-2">✓</span>{i}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">Fragen zum Dachbodenausbau</h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6">Verwandte Leistungen</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="/leistungen/dachaufstockung" class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-slate-800 mb-1">Dachaufstockung</h3>
              <p class="text-slate-600 text-sm">Wenn der Dachboden zu klein ist.</p>
            </a>
            <a href="/leistungen/dachdaemmung" class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-slate-800 mb-1">Dachdämmung</h3>
              <p class="text-slate-600 text-sm">GEG-konform, förderfähig.</p>
            </a>
            <a href="/leistungen/gaubenbau" class="bg-white rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-slate-800 mb-1">Gaubenbau</h3>
              <p class="text-slate-600 text-sm">Mehr Stehhöhe und Licht.</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Dachboden ausbauen" subtitle="Kostenlose Vor-Ort-Inspektion." buttonText="Termin anfragen" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
