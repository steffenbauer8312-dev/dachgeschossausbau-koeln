---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Wann muss der Dachstuhl verstärkt werden?',
    answer: 'Vor allem wenn das Dachgeschoss zu Wohnzwecken ausgebaut werden soll und die vorhandene Statik für die neue Belastung nicht reicht. Auch bei Aufstockungen, dem Einbau schwerer Gauben oder dem Tausch der Eindeckung gegen Zink oder Dachstein kann eine Verstärkung nötig werden.'
  },
  {
    question: 'Welche Methoden der Verstärkung gibt es?',
    answer: 'Wir setzen Aufdopplungen (KVH an bestehende Sparren schrauben), Wechsel-Einbau für Lastenumlagerung, zusätzliche Pfosten oder Stahlzugbänder ein. Bei minimalem Eingriff sind GFK-Profile oder Stahlbau-Aufdopplungen eine Alternative.'
  },
  {
    question: 'Was kostet eine Dachstuhlverstärkung?',
    answer: 'Eine Verstärkung liegt typisch zwischen 4.000 und 18.000 Euro. Bei wenigen Sparren mit Aufdopplung sind 4.000 bis 8.000 Euro realistisch. Mit Wechsel-Einbau oder Pfostenverstärkung kommen wir auf 10.000 bis 18.000 Euro.'
  },
  {
    question: 'Brauche ich für die Verstärkung eine Baugenehmigung?',
    answer: 'Eine Verstärkung ist Teil der Baumaßnahme und wird mit dem DG-Ausbau zusammen beantragt. Bei Aufstockung oder größeren Eingriffen brauchen wir eine separate Statik und Baugenehmigung. Reine Verstärkungsmaßnahmen am Bestandsdach können genehmigungsfrei sein, wenn die Statik nachweislich gleich bleibt.'
  },
  {
    question: 'Wird die Wohnfläche durch die Verstärkung kleiner?',
    answer: 'Meistens nicht. Wir arbeiten so platzsparend wie möglich. Bei Aufdopplungen verlieren Sie etwa 6 bis 10 cm an Kopfhöhe im Bereich der Sparren. Diese Bereiche lassen sich geschickt mit Einbauschränken oder Lichtkonzepten kaschieren.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Dachstuhlverstärkung",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Dachgeschossausbau Köln" }
};
---

<BaseLayout
  title="Dachstuhlverstärkung Köln | Tragfähigkeit ertüchtigen"
  description="Dachstuhlverstärkung in Köln für den Dachgeschossausbau: Aufdopplung, Wechsel, Pfosten. Tragfähigkeit statisch nachgewiesen erhöhen."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/leistungen" class="hover:text-teal-400">Leistungen</a> /
              <span class="text-white">Dachstuhlverstärkung</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">Dachstuhlverstärkung in Köln</h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Sie wollen das Dach ausbauen, der Dachstuhl trägt aber nicht? Wir verstärken gezielt, ohne das ganze Dach neu zu bauen. Aufdopplung, Wechsel, Stahlband, Pfosten: jede Methode mit Statik und Dokumentation.
            </p>
          </div>
          <LeadForm variant="inline" title="Verstärkung planen" subtitle="Statiker prüft Tragfähigkeit." buttonText="Beratung anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">Tragfähigkeit punktgenau erhöhen</h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              In Köln stehen viele Häuser, deren Dachstuhl noch aus der ursprünglichen Bauzeit stammt. Bei Einfamilienhäusern in Porz oder Reihenhäusern in Nippes bedeutet das oft: die Sparren sind für die Eigenlast und eine Schneelastzone 1 oder 2 ausgelegt, aber nicht für spätere Wohnlast. Wenn das Dach jetzt zum Wohnraum werden soll, brauchen wir mehr Tragfähigkeit.
            </p>
            <p>
              Eine Verstärkung ist immer dann die richtige Wahl, wenn das Tragwerk im Grundsatz gesund ist. Wir tauschen kein Holz, das noch Jahrzehnte halten kann. Wir verstärken nur da, wo die Statik es verlangt. Das spart Kosten, schont die Substanz und passt zu denkmalgeschützten Häusern, wo jeder Eingriff begründet sein muss.
            </p>
            <p>
              Die häufigste Methode ist die Aufdopplung: wir schrauben KVH-Hölzer auf die bestehenden Sparren und gewinnen so ein paar Millimeter bis Zentimeter mehr Tragfähigkeit. Bei größeren Eingriffen setzen wir Wechsel ein oder hängen Stahlbänder als Zugelement. Welche Lösung passt, sagt Ihnen unser Statiker nach der Vor-Ort-Aufnahme.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">Verstärkungsmethoden im Überblick</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { t: 'Sparrenaufdopplung', d: 'KVH oder BSH auf bestehende Sparren geschraubt. Wirkt sich minimal auf die Raumhöhe aus.' },
              { t: 'Wechsel', d: 'Horizontale Balken zur Lastenumlagerung. Ermöglicht den Wegfall von Pfosten oder die Erweiterung von Öffnungen.' },
              { t: 'Stahlband', d: 'Flachstahl als Zugelement. Unsichtbar im Bodenaufbau oder unter Putz.' },
              { t: 'GFK-Profile', d: 'Glasfaserverstärkte Kunststoffprofile als Ersatz für schwere Hölzer. Vor allem bei denkmalgeschützten Objekten.' },
              { t: 'Pfostenverstärkung', d: 'Pfosten-Stahlkern oder Doppel-Pfosten. Wenn die Vertikallast kritisch wird.' },
              { t: 'Ringbalken', d: 'Umfassender Ringanker am Wandkopf. Wirkt als Bindeglied und verteilt die Dachlast gleichmäßig.' }
            ].map(i => (
              <div class="bg-white rounded-xl p-5 shadow-sm">
                <h3 class="font-bold text-slate-800 mb-2">{i.t}</h3>
                <p class="text-slate-600 text-sm">{i.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">Fragen zur Verstärkung</h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Verstärkung planen" subtitle="Statiker prüft Tragfähigkeit." buttonText="Beratung anfragen" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
