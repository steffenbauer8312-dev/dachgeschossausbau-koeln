---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was ist Holzrahmenbau?',
    answer: 'Beim Holzrahmenbau werden Wände und Dachelemente als Holzrahmenkonstruktion im Werk vorgefertigt und auf der Baustelle aufgestellt. Das geht schnell, ist trocken und hat gute Dämmeigenschaften. Wir nutzen den Holzrahmenbau in Köln vor allem für Aufstockungen und Dachgauben.'
  },
  {
    question: 'Wie schnell ist eine Holzrahmenbauwand aufgebaut?',
    answer: 'Ein vorgefertigtes Wandelement ist innerhalb von ein bis zwei Stunden aufgestellt. Ein komplettes Dachgeschoss in Holzrahmenbauweise steht innerhalb von einer Woche. Danach folgen Dämmung, Dampfsperre und Innenverkleidung aus Trockenbau.'
  },
  {
    question: 'Wie gut dämmt eine Holzrahmenbauwand?',
    answer: 'Sehr gut. Mit 200 mm Mineralwolle in den Gefachen plus 60 mm Aufsparren- oder Untersparren-Dämmung erreichen wir U-Werte unter 0,18 W/m²K. Das ist deutlich besser als die GEG-Anforderung und qualifiziert für BAFA-Förderung.'
  },
  {
    question: 'Ist Holzrahmenbau auch bei Denkmalschutz möglich?',
    answer: 'Innen ja, außen eingeschränkt. Bei denkmalgeschützten Fassaden bleibt die Hülle unangetastet, innen kann eine Holzrahmenbauwand als Trockenbau-Konstruktion eingebaut werden. Bei Aufstockungen in Marienburg oder Ehrenfeld kommt es auf den Einzelfall an, wir stimmen mit dem Denkmalamt ab.'
  },
  {
    question: 'Was kostet Holzrahmenbau?',
    answer: 'Eine tragende Holzrahmenbauwand liegt zwischen 180 und 260 Euro pro Quadratmeter, je nach Dämmstärke und Beplankung. Ein komplettes Dachgeschoss in Holzrahmenbauweise rechnen wir mit 380 bis 550 Euro pro Quadratmeter Wand- und Deckenfläche.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Holzrahmenbau",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Dachgeschossausbau Köln" }
};
---

<BaseLayout
  title="Holzrahmenbau Köln | Vor­gefertigte Wand­elemente"
  description="Holzrahmenbau in Köln: vorgefertigte Wand- und Deckenelemente für Aufstockungen, Anbauten und Dachgeschosse. Schnell, trocken, gut gedämmt."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/leistungen" class="hover:text-teal-400">Leistungen</a> /
              <span class="text-white">Holzrahmenbau</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">Holzrahmenbau in Köln</h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Schneller als Massivbau, leichter als Mauerwerk, besser gedämmt als konventionelle Bauweise. Wir setzen auf Holzrahmenbau für Aufstockungen, Anbauten und Gauben in Köln. Vorgefertigt im Werk, in Tagen aufgebaut.
            </p>
          </div>
          <LeadForm variant="inline" title="Holzrahmenbau planen" subtitle="Welche Dimension passt?" buttonText="Beratung anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">Werkstattbau statt Baustellenbau</h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Beim Holzrahmenbau laufen die Wände unter kontrollierten Bedingungen im Werk vom Band. Das hat zwei Vorteile: gleichbleibende Qualität und hohe Geschwindigkeit auf der Baustelle. Wir setzen die Elemente innerhalb von Stunden auf, anschließend wird die Dämmung eingeblasen und die Dampfsperre montiert. Das Wetter bleibt draußen, die Bewohner können oft im Haus wohnen bleiben.
            </p>
            <p>
              In Köln haben wir Holzrahmenbau vor allem bei Aufstockungen in dichten Vierteln wie Ehrenfeld und Nippes realisiert. Die Bauteile kommen just in time mit dem LKW, der Kran hebt sie aufs Dach. Bei einem typischen Projekt mit 80 Quadratmetern Dachgeschoss-Fläche ist die Rumpfkonstruktion in zwei bis drei Tagen oben, danach folgt der Innenausbau.'
            </p>
            <p>
              Holzrahmenbau kommt mit niedrigen Lasten aus, was bei Bestandsgebäuden mit knapp dimensionierten Außenwänden von Vorteil ist. Die Wandstärke von 200 bis 300 mm inklusive Dämmung bringt schlanke Wandquerschnitte und mehr Innenraum. Wer mit Mauerwerk plant, braucht oft doppelt so viel Wandstärke für die gleiche Dämmwirkung.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">Vorteile im Überblick</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {[
              { t: 'Schnelle Bauzeit', d: 'Wände stehen in Stunden, ein Geschoss in Tagen. Wegen Trockenbau fallen keine Trocknungszeiten an.' },
              { t: 'Sehr gute Dämmung', d: '200 bis 300 mm Mineralwolle oder Hanf erreichen Passivhaus-Niveau.' },
              { t: 'Niedriges Eigengewicht', d: 'Eine Holzrahmenbauwand wiegt etwa ein Viertel einer vergleichbaren Massivbauwand.' },
              { t: 'Trockene Bauweise', d: 'Wenig Feuchtigkeit, kurze Wartezeit, schneller Bezug der Räume.' },
              { t: 'Hohe Vorfertigung', d: 'Qualität im Werk statt auf der Baustelle, sauberer und reproduzierbarer.' },
              { t: 'Diffusionsoffen möglich', d: 'Wer auf Holzbau mit Hanf und Holzfaserdämmung setzt, bekommt ein angenehmes Raumklima.' }
            ].map(i => (
              <div class="bg-white rounded-xl p-5 shadow-sm">
                <h3 class="font-bold text-slate-800 mb-2">{i.t}</h3>
                <p class="text-slate-600 text-sm">{i.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">Fragen zum Holzrahmenbau</h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Holzrahmenbau anfragen" subtitle="Welche Dimension passt?" buttonText="Beratung anfragen" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
