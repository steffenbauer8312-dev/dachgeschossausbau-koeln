---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';

const faqs = [
  {
    question: 'Was kostet eine Gaube in Köln?',
    answer: 'Eine Standard-Trapezgaube mit Putz- oder Holzfassade kostet zwischen 8.000 und 12.000 Euro. Sattelgauben liegen bei 9.000 bis 14.000 Euro. Aufwendige Sonderlösungen mit Balkon oder Loggia starten bei 15.000 Euro.'
  },
  {
    question: 'Brauche ich für den Gaubenbau eine Baugenehmigung?',
    answer: 'Ja, jede Gaube ist in Köln genehmigungspflichtig. Wir kümmern uns um den Antrag, die Statik und die Abstimmung mit dem Bauaufsichtsamt. Bei Reihen- und Doppelhäusern brauchen wir oft auch die Zustimmung der direkten Nachbarn.'
  },
  {
    question: 'Welche Gaubenform passt zu meinem Haus?',
    answer: 'Bei denkmalgeschützten Häusern in Ehrenfeld oder Marienburg sind Sattelgauben häufig Pflicht. In modernen Vierteln wie Kalk oder Deutz kommen Flachdachgauben in Frage. Bei klassischen Reihenhäusern in Nippes oder Lindenthal sind Trapezgauben die gängige Lösung. Wir sehen uns das Haus an und empfehlen die passende Form.'
  },
  {
    question: 'Wie lange dauert der Bau einer Gaube?',
    answer: 'Vom ersten Spatenstich bis zur fertigen Gaube rechnen wir mit zwei bis vier Wochen. Mit Beantragung und Wartezeit auf die Baugenehmigung kommen zwei bis drei Monate zusammen. Wir koordinieren alle Gewerke: Zimmermann, Dachdecker, Putzer, Maler.'
  },
  {
    question: 'Kann ich auch mehrere Gauben gleichzeitig bauen?',
    answer: 'Ja, das geht und ist oft günstiger pro Stück, weil Gerüst und Anlieferung nur einmal aufgebaut werden. Für ein 60-Quadratmeter-Dachgeschoss sind drei Gauben ideal, weil sie gleichmäßig Licht und Stehhöhe bringen.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Gaubenbau",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Dachgeschossausbau Köln" }
};
---

<BaseLayout
  title="Gaubenbau Köln | Trapez, Sattel, Flachdach"
  description="Gaubenbau in Köln: Trapezgauben, Sattelgauben, Flachdachgauben. Mehr Stehhöhe, mehr Licht, mehr Wohnkomfort im Dachgeschoss."
>
  <Header />

  <main>
    <section class="bg-gradient-to-br from-slate-800 to-slate-900 text-white py-16 md:py-24">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <nav class="text-sm text-slate-300 mb-4">
              <a href="/" class="hover:text-teal-400">Startseite</a> /
              <a href="/leistungen" class="hover:text-teal-400">Leistungen</a> /
              <span class="text-white">Gaubenbau</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">Gaubenbau in Köln</h1>
            <p class="text-xl text-slate-300 max-w-2xl">
              Eine Gaube schafft Stehhöhe, bringt Licht und gibt dem Dachgeschoss Charakter. Wir bauen Trapez-, Sattel- und Flachdachgauben, vom Altbau in Ehrenfeld bis zum Reihenhaus in Porz.
            </p>
          </div>
          <LeadForm variant="inline" title="Gaube planen" subtitle="Welche Form passt zu Ihrem Dach?" buttonText="Beratung anfragen" />
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-6">Warum eine Gaube fast immer sinnvoll ist</h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Bei einem durchschnittlichen Kölner Dachgeschoss haben Sie ohne Gaube vielleicht 1,20 Meter Stehhöhe am First und nur 50 bis 70 Zentimeter an den Seitenwänden. Eine Gaube schafft auf einer Breite von 1,50 bis 3 Metern volle Stehhöhe. Aus einem Raum zum Kriechen wird ein Raum zum Leben. Gleichzeitig fällt mehr Licht ins Dach, was den gesamten Raum heller und freundlicher macht.
            </p>
            <p>
              Welche Gaubenform möglich ist, hängt vom Bebauungsplan, der Nachbarbebauung und ggf. den Denkmalschutzauflagen ab. In Köln ist die Trapezgaube am weitesten verbreitet, weil sie zu fast allen Dächern passt und eine gute Lichtausbeute bietet. Sattelgauben sind die traditionsreichere Wahl, Flachdachgauben sind die moderne. Wir stimmen die Form auf Ihr Haus und die Umgebung ab.'
            </p>
            <p>
              Beim Bau gehen wir so vor: Aussparung im Dach herausschneiden, Wechsel einbauen für die Lastenumlagerung, Holzrahmen aufstellen, dämmen, Unterspannbahn und Lattung, Eindeckung passend zum Bestand. Putz oder Verkleidung außen, Gipskarton und Dämmung innen. Die Koordination aller Gewerke läuft bei uns aus einer Hand.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">Sechs Gaubenformen im Überblick</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {[
              { t: 'Trapezgaube', d: 'Am häufigsten in Köln. Gute Lichtausbeute, passt zu den meisten Dächern.' },
              { t: 'Sattelgaube', d: 'Klassisch und traditionell. Häufig Pflicht bei denkmalgeschützten Häusern.' },
              { t: 'Flachdachgaube', d: 'Modern, klare Linien. In Kalk und Deutz häufig.' },
              { t: 'Schleppgaube', d: 'Flach und lang. Für breite Dächer mit viel zusätzlicher Fläche.' },
              { t: 'Rundgaube', d: 'Auffällig und elegant. Bei Premiumobjekten in Marienburg.' },
              { t: 'Zwerchgiebel', d: 'Fast ein Vollgeschoss. Viel Platz, braucht aber mehr Höhe im Firstbereich.' }
            ].map(i => (
              <div class="bg-white rounded-xl p-5 shadow-sm">
                <h3 class="font-bold text-slate-800 mb-2">{i.t}</h3>
                <p class="text-slate-600 text-sm">{i.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8 text-center">Fragen zum Gaubenbau</h2>
          <FAQ faqs={faqs} />
        </div>
      </div>
    </section>

    <LeadForm variant="full" title="Gaube planen" subtitle="Welche Form passt zu Ihrem Dach?" buttonText="Beratung anfragen" />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
