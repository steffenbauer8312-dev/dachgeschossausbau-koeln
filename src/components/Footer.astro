---
const currentYear = new Date().getFullYear();

const footerLinks = {
  leistungen: [
    { name: 'Statik & Bestandsaufnahme', href: '/leistungen/statik' },
    { name: 'Dachgauben', href: '/leistungen/gauben' },
    { name: 'Dachdämmung', href: '/leistungen/daemmung' },
    { name: 'Trockenbau', href: '/leistungen/trockenbau' },
    { name: 'Bad & Sanitär', href: '/leistungen/bad' },
  ],
  info: [
    { name: 'Förderungen', href: '/foerderungen' },
    { name: 'Kosten', href: '/kosten' },
    { name: 'Kölner Stadtteile', href: '/stadtteile' },
    { name: 'Über uns', href: '/ueber-uns' },
    { name: 'Kontakt', href: '/kontakt' },
  ]
};
---

<footer class="bg-slate-800 text-slate-300">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div>
        <h3 class="text-white font-bold text-lg mb-4">Dachgeschossausbau Köln</h3>
        <p class="text-sm mb-4">
          Wir verwandeln ungenutzte Dachböden in wertvollen Wohnraum – professionell, aus einer Hand, zu fairen Preisen.
        </p>
        <div class="flex items-center gap-2 text-teal-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="text-sm">Hauptstr. 134, 51143 Köln</span>
        </div>
      </div>

      <!-- Leistungen -->
      <div>
        <h4 class="text-white font-semibold mb-4">Leistungen</h4>
        <ul class="space-y-2 text-sm">
          {footerLinks.leistungen.map(link => (
            <li>
              <a href={link.href} class="hover:text-teal-400 transition-colors duration-200">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Informationen</h4>
        <ul class="space-y-2 text-sm">
          {footerLinks.info.map(link => (
            <li>
              <a href={link.href} class="hover:text-teal-400 transition-colors duration-200">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4">Kontakt</h4>
        <div class="space-y-3 text-sm">
          <a href="tel:+4915216117439" class="flex items-center gap-2 hover:text-teal-400 transition-colors duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +49 152 16117439
          </a>
          <a href="mailto:info@dachgeschossausbaukoeln.de" class="flex items-center gap-2 hover:text-teal-400 transition-colors duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            info@dachgeschossausbaukoeln.de
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-700 mt-8 pt-8 flex flex-wrap justify-between items-center gap-4 text-sm">
      <p>&copy; {currentYear} Dachgeschossausbau Köln. Alle Rechte vorbehalten.</p>
      <div class="flex gap-6">
        <a href="/impressum" class="hover:text-teal-400 transition-colors duration-200">Impressum</a>
        <a href="/datenschutz" class="hover:text-teal-400 transition-colors duration-200">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>