---
const year = new Date().getFullYear();
const services = [
  { name: 'Dachgeschossausbau', href: '/leistungen/dachgeschossausbau/' },
  { name: 'Dachaufstockung', href: '/leistungen/dachaufstockung/' },
  { name: 'Dachgauben', href: '/leistungen/gauben/' },
  { name: 'Dachdämmung', href: '/leistungen/daemmung/' }
];
const guides = [
  { name: 'Kosten einordnen', href: '/ratgeber/kosten-dachgeschossausbau-pro-qm/' },
  { name: 'Baugenehmigung Köln', href: '/ratgeber/baugenehmigung-dachgeschoss-koeln/' },
  { name: 'Aufstockung oder Ausbau', href: '/ratgeber/dachaufstockung-oder-ausbau/' }
];
---

<footer class="bg-slate-900 text-slate-300">
  <div class="container mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <h2 class="text-lg font-bold text-white">Dachgeschossausbau Köln</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed">Informationen und Anfragevorbereitung rund um Dachgeschossausbau, Dachaufstockung und Ausbauplanung in Köln.</p>
        <p class="mt-4 text-sm">Hauptstr. 134, 51143 Köln<br /><a class="hover:text-teal-300" href="tel:+4915216117439">+49 152 16117439</a><br /><a class="hover:text-teal-300" href="mailto:info@dachgeschossausbau-koeln.de">info@dachgeschossausbau-koeln.de</a></p>
      </div>
      <div><h2 class="text-sm font-semibold uppercase tracking-wide text-white">Leistungen</h2><ul class="mt-4 space-y-2 text-sm">{services.map(item => <li><a class="hover:text-teal-300" href={item.href}>{item.name}</a></li>)}</ul></div>
      <div><h2 class="text-sm font-semibold uppercase tracking-wide text-white">Ratgeber</h2><ul class="mt-4 space-y-2 text-sm">{guides.map(item => <li><a class="hover:text-teal-300" href={item.href}>{item.name}</a></li>)}</ul></div>
    </div>
    <div class="mt-10 border-t border-slate-700 pt-6 text-sm">
      <p class="max-w-4xl text-slate-400">Hinweis: Diese Website dient der Anfragevorbereitung und Vermittlung. Eine Anfrage ist keine Beauftragung; die konkrete Eignung, Planung und Ausführung wird mit dem jeweils zuständigen Fachbetrieb und den erforderlichen Planern geklärt.</p>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2"><span>© {year} Dachgeschossausbau Köln</span><a class="hover:text-teal-300" href="/impressum/">Impressum</a><a class="hover:text-teal-300" href="/datenschutz/">Datenschutz</a><a class="hover:text-teal-300" href="/kontakt/">Kontakt</a></div>
    </div>
  </div>
</footer>
