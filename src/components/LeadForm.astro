---
interface Props {
  variant?: 'inline' | 'full';
  formId?: string;
  title?: string;
  subtitle?: string;
  buttonText?: string;
  service?: string;
}

const { variant = 'full', formId, title, subtitle, buttonText = 'Anfrage senden', service = 'Dachgeschossausbau' } = Astro.props;
const uid = formId ?? `lead-${variant}`;
const projects = [
  { value: 'dachgeschossausbau', label: 'Dachgeschossausbau' },
  { value: 'dachaufstockung', label: 'Dachaufstockung' },
  { value: 'gaube', label: 'Dachgaube oder Dachaufbau' },
  { value: 'daemmung', label: 'Dachdämmung' },
  { value: 'dachfenster', label: 'Dachfenster' },
  { value: 'dachterrasse', label: 'Dachterrasse' },
  { value: 'innenausbau', label: 'Innenausbau im Dachgeschoss' },
  { value: 'sonstiges', label: 'Sonstiges' }
];
---

{variant === 'inline' && <div class="rounded-2xl bg-white p-5 text-slate-800 shadow-2xl md:p-6">
  <h2 class="text-xl font-bold">{title ?? 'Vorhaben kurz einordnen'}</h2>
  <p class="mt-1 text-sm text-slate-600">{subtitle ?? 'Ein paar Eckdaten reichen für den ersten Kontakt.'}</p>
  <form id={uid} class="mt-5 space-y-3" action="/api/lead" method="POST">
    <input type="hidden" name="service" value={service} /><input type="hidden" name="city" value="Köln" /><input type="hidden" name="source" value="Website Formular Hero" /><input type="hidden" name="redirect" value="/danke/" />
    <input type="text" name="url" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
    <label class="sr-only" for={`${uid}-name`}>Name</label><input id={`${uid}-name`} name="name" required autocomplete="name" placeholder="Name *" class="form-control" />
    <label class="sr-only" for={`${uid}-email`}>E-Mail</label><input id={`${uid}-email`} name="email" required type="email" autocomplete="email" placeholder="E-Mail *" class="form-control" />
    <label class="sr-only" for={`${uid}-phone`}>Telefon</label><input id={`${uid}-phone`} name="phone" required type="tel" autocomplete="tel" placeholder="Telefon *" class="form-control" />
    <label class="sr-only" for={`${uid}-project`}>Projekttyp</label><select id={`${uid}-project`} name="projekttyp" required class="form-control"><option value="">Projekttyp wählen *</option>{projects.map(project => <option value={project.value}>{project.label}</option>)}</select>
    <label class="flex items-start gap-2 text-xs text-slate-600"><input class="mt-0.5" type="checkbox" name="privacy" value="accepted" required /> <span>Ich akzeptiere die <a class="text-teal-700 underline" href="/datenschutz/">Datenschutzerklärung</a>.</span></label>
    <button class="form-submit" type="submit">{buttonText}</button>
  </form>
</div>}

{variant === 'full' && <section class="bg-teal-700 py-14 text-white md:py-20">
  <div class="container mx-auto max-w-3xl px-4">
    <h2 class="text-center text-2xl font-bold md:text-3xl">{title ?? 'Projekt in Köln besprechen'}</h2>
    <p class="mx-auto mt-2 max-w-2xl text-center text-teal-100">{subtitle ?? 'Senden Sie die Eckdaten Ihres Vorhabens. Unvollständige Unterlagen sind in Ordnung.'}</p>
    <form id={uid} class="mt-8 rounded-2xl bg-white p-6 text-slate-800 shadow-2xl md:p-8" action="/api/lead" method="POST">
      <input type="hidden" name="service" value={service} /><input type="hidden" name="city" value="Köln" /><input type="hidden" name="source" value="Website Formular Seitenende" /><input type="hidden" name="redirect" value="/danke/" />
      <input type="text" name="url" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
      <div class="grid gap-5 md:grid-cols-2">
        <div><label class="form-label" for={`${uid}-name`}>Name *</label><input id={`${uid}-name`} name="name" required autocomplete="name" class="form-control" /></div>
        <div><label class="form-label" for={`${uid}-email`}>E-Mail *</label><input id={`${uid}-email`} name="email" required type="email" autocomplete="email" class="form-control" /></div>
        <div><label class="form-label" for={`${uid}-phone`}>Telefon *</label><input id={`${uid}-phone`} name="phone" required type="tel" autocomplete="tel" class="form-control" /></div>
        <div><label class="form-label" for={`${uid}-project`}>Projekttyp *</label><select id={`${uid}-project`} name="projekttyp" required class="form-control"><option value="">Bitte wählen</option>{projects.map(project => <option value={project.value}>{project.label}</option>)}</select></div>
        <div class="md:col-span-2"><label class="form-label" for={`${uid}-message`}>Nachricht</label><textarea id={`${uid}-message`} name="message" rows="5" class="form-control" placeholder="Was möchten Sie im Dachgeschoss verändern?"></textarea></div>
        <label class="flex items-start gap-2 text-xs text-slate-600 md:col-span-2"><input class="mt-0.5" type="checkbox" name="privacy" value="accepted" required /> <span>Ich akzeptiere die <a class="text-teal-700 underline" href="/datenschutz/">Datenschutzerklärung</a>.</span></label>
        <div class="md:col-span-2"><button class="form-submit" type="submit">{buttonText}</button></div>
      </div>
    </form>
  </div>
</section>}

<style>
  .form-control { width: 100%; border: 1px solid rgb(203 213 225); border-radius: .65rem; background: white; padding: .72rem .85rem; color: rgb(30 41 59); }
  .form-control:focus { outline: 3px solid rgba(45, 212, 191, .35); outline-offset: 1px; border-color: rgb(13 148 136); }
  .form-label { display: block; margin-bottom: .4rem; font-size: .875rem; font-weight: 600; color: rgb(51 65 85); }
  .form-submit { width: 100%; border: 0; border-radius: .65rem; background: rgb(13 148 136); color: white; cursor: pointer; padding: .8rem 1rem; font-weight: 700; transition: background .2s ease; }
  .form-submit:hover { background: rgb(15 118 110); }
</style>
