---
interface Service {
  title: string;
  description: string;
  icon: string;
  href: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {services.map(service => (
    <a
      href={service.href}
      class="group bg-white rounded-xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border border-slate-100 hover:border-teal-200"
    >
      <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-teal-500 transition-colors duration-300">
        <Fragment set:html={service.icon} />
      </div>
      <h3 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-teal-600 transition-colors duration-300">
        {service.title}
      </h3>
      <p class="text-slate-600 text-sm leading-relaxed">
        {service.description}
      </p>
      <div class="mt-4 flex items-center gap-1 text-teal-600 font-medium text-sm">
        Mehr erfahren
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>
  ))}
</div>