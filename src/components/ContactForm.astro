---
interface Props {
  showPLZ?: boolean;
}

const { showPLZ = true } = Astro.props;
---

<section class="bg-gradient-to-br from-teal-600 to-teal-700 text-white py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-2 text-center">
        Jetzt kostenlose Beratung anfragen
      </h2>
      <p class="text-teal-100 text-center mb-8">
        Wir melden uns innerhalb von 24 Stunden bei Ihnen.
      </p>

      <form class="bg-white rounded-xl p-6 md:p-8 shadow-2xl" id="contact-form">
        <div class="space-y-5">
          <!-- Name -->
          <div>
            <label for="name" class="block text-slate-700 font-medium mb-1.5 text-sm">Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Max Mustermann"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200"
            />
          </div>

          <!-- Phone & Email -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="phone" class="block text-slate-700 font-medium mb-1.5 text-sm">Telefon *</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="+49 123 456789"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200"
              />
            </div>
            <div>
              <label for="email" class="block text-slate-700 font-medium mb-1.5 text-sm">E-Mail *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="ihre@email.de"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200"
              />
            </div>
          </div>

          <!-- PLZ (optional) -->
          {showPLZ && (
            <div>
              <label for="plz" class="block text-slate-700 font-medium mb-1.5 text-sm">Postleitzahl (Köln)</label>
              <input
                type="text"
                id="plz"
                name="plz"
                pattern="[0-9]{5}"
                placeholder="50668"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200"
              />
            </div>
          )}

          <!-- Project Type -->
          <div>
            <label for="project-type" class="block text-slate-700 font-medium mb-1.5 text-sm">Art des Vorhabens</label>
            <select
              id="project-type"
              name="project-type"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200"
            >
              <option value="">Bitte auswählen...</option>
              <option value="wohnraumausbau">Wohnraumausbau im Dachgeschoss</option>
              <option value="dachgaube">Einbau einer Dachgaube</option>
              <option value="daemmung">Dachdämmung (GEG)</option>
              <option value="komplett">Kompletter Dachgeschossausbau</option>
              <option value="sonstiges">Sonstiges</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-slate-700 font-medium mb-1.5 text-sm">Nachricht</label>
            <textarea
              id="message"
              name="message"
              rows={4}
              placeholder="Beschreiben Sie kurz Ihr Vorhaben..."
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-slate-800 transition-all duration-200 resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-teal-500 hover:bg-teal-600 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            Anfrage absenden
          </button>

          <p class="text-xs text-slate-500 text-center">
            Mit dem Absenden stimmen Sie unserer Datenschutzerklärung zu.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      button.innerHTML = `
        <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Wird gesendet...
      `;

      // Simulate form submission
      await new Promise(resolve => setTimeout(resolve, 1500));

      button.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Anfrage gesendet!
      `;
      button.classList.remove('bg-teal-500', 'hover:bg-teal-600');
      button.classList.add('bg-green-500');

      setTimeout(() => {
        form.reset();
        button.disabled = false;
        button.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          Anfrage absenden
        `;
        button.classList.remove('bg-green-500');
        button.classList.add('bg-teal-500', 'hover:bg-teal-600');
      }, 3000);
    });
  }
</script>