---
const navItems = [
  { name: 'Leistungen', href: '/leistungen/' },
  { name: 'Ratgeber', href: '/ratgeber/' },
  { name: 'Ablauf in Köln', href: '/stadtteile/' },
  { name: 'Kontakt', href: '/kontakt/' }
];
---

<header class="sticky top-0 z-50 border-b border-slate-700 bg-slate-900 text-white shadow-lg">
  <nav class="container mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3" aria-label="Hauptnavigation">
    <a href="/" class="flex items-center gap-3" aria-label="Dachgeschossausbau Köln Startseite">
      <img src="/logo.png" alt="Dachgeschossausbau Köln" class="h-11 w-auto" width="176" height="44" />
      <span class="hidden text-sm font-bold leading-tight sm:block">Dachgeschossausbau<br /><span class="text-teal-300">Köln</span></span>
    </a>
    <button id="mobile-menu-btn" class="rounded-lg p-2 hover:bg-slate-800 lg:hidden" aria-label="Menü öffnen" aria-controls="mobile-menu" aria-expanded="false">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
    <div class="hidden items-center gap-6 lg:flex">
      <ul class="flex items-center gap-6">{navItems.map(item => <li><a class="text-sm font-medium text-slate-200 transition hover:text-teal-300" href={item.href}>{item.name}</a></li>)}</ul>
      <a href="/kontakt/" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-400">Anfrage senden</a>
    </div>
  </nav>
  <div id="mobile-menu" class="container mx-auto hidden max-w-7xl border-t border-slate-700 px-4 pb-4 lg:hidden">
    <ul class="space-y-2 pt-3">{navItems.map(item => <li><a class="block rounded-lg px-3 py-2 text-slate-200 hover:bg-slate-800 hover:text-teal-300" href={item.href}>{item.name}</a></li>)}</ul>
    <a href="/kontakt/" class="mt-3 block rounded-lg bg-teal-500 px-4 py-3 text-center font-semibold text-white">Anfrage senden</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = !menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
